---
import '../styles/global.css';
import ScrollReveal from '../components/ScrollReveal.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '선교비전교회 - 일어나 빛을 발하라' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="rW6tJwEs12Wbfbox5TBROo9Ofypg4yb_Jz7f-5sp8tc"
    />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="grain-overlay bg-cream text-charcoal antialiased selection:bg-accent/20 selection:text-charcoal">
    <slot />
    <ScrollReveal />
  </body>
</html>
