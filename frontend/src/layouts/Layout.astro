---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '선교비전교회 - 일어나 빛을 발하라' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-white text-text-main antialiased selection:bg-primary/20 selection:text-primary-dark">
    <slot />
  </body>
</html>
