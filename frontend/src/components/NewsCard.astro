---
import { marked } from 'marked';

interface Props {
  news: {
    title: string;
    date: string;
    content: string;
    important?: boolean;
    featured?: boolean;
    category?: string;
    image?: string;
  };
  featured?: boolean;
}

const { news, featured = false } = Astro.props;
const dateObj = new Date(news.date);
const formattedDate = dateObj.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const monthShort = dateObj.toLocaleDateString('en-US', { month: 'short' });
const day = dateObj.getDate();

const htmlContent = await marked(news.content || '');

// Category color mapping
const categoryColors: Record<string, { bg: string; text: string; darkBg: string; darkText: string }> = {
  'Youth': { bg: 'bg-purple-100', text: 'text-purple-700', darkBg: 'dark:bg-purple-900/30', darkText: 'dark:text-purple-300' },
  'Building': { bg: 'bg-amber-100', text: 'text-amber-700', darkBg: 'dark:bg-amber-900/30', darkText: 'dark:text-amber-300' },
  'Community': { bg: 'bg-green-100', text: 'text-green-700', darkBg: 'dark:bg-green-900/30', darkText: 'dark:text-green-300' },
  'Service': { bg: 'bg-blue-100', text: 'text-blue-700', darkBg: 'dark:bg-blue-900/30', darkText: 'dark:text-blue-300' },
  'Event': { bg: 'bg-primary/90', text: 'text-white', darkBg: 'dark:bg-primary/90', darkText: 'dark:text-white' },
};

const categoryColor = news.category ? categoryColors[news.category] || categoryColors['Event'] : categoryColors['Event'];
const defaultImage = 'https://lh3.googleusercontent.com/aida-public/AB6AXuDwVFwcFVHohR2bALgDmUdUssZ6_ys1qlxMudH86vFq2iNlQGve0_mtImRZnYDno3zKdgM46Pk17QZ0lbJAHHmsvaqCqODdh3OZ8sp0ddvli99DKpLoipnnaWSIx1Tv2xM2D-J9WBs8lHJ-WImlS7aoGqTla0cQkSJY7u9kRKPmWjTWMJ0Klsfsr0sQJbJEHsLm95Gu36-uUARohj0L27GZKF5xfxIS3Rxo9kulHp8O89aGXdlLWl0oELbtBxNiyNKITdzLX6X0GeSd';
---

{featured ? (
  <!-- Featured Card -->
  <div class="group relative overflow-hidden rounded-xl bg-white dark:bg-slate-800 shadow-md transition-all hover:shadow-lg border border-slate-100 dark:border-slate-700">
    <div class="aspect-[16/9] w-full bg-slate-200 relative overflow-hidden">
      <img 
        alt={news.title} 
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
        src={news.image || defaultImage}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
      {news.category && (
        <span class={`absolute top-3 left-3 ${categoryColor.bg} ${categoryColor.text} ${categoryColor.darkBg} ${categoryColor.darkText} backdrop-blur-sm text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wide`}>
          {news.category}
        </span>
      )}
    </div>
    <div class="p-5">
      <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-tight mb-2">{news.title}</h3>
      <div class="prose prose-sm max-w-none text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-4 line-clamp-3" set:html={htmlContent}></div>
      <a 
        href={`/news/${news.slug || '#'}`}
        class="inline-flex items-center text-sm font-semibold text-primary hover:text-primary/80 transition-colors"
      >
        Read Details 
        <span class="material-symbols-outlined ml-1 text-lg">arrow_forward</span>
      </a>
    </div>
  </div>
) : (
  <!-- List Item Card -->
  <article class="flex gap-4 p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow cursor-pointer">
    <div class={`shrink-0 flex flex-col items-center justify-center w-14 h-14 rounded-lg ${
      news.category === 'Youth' || news.important 
        ? 'bg-primary/10 dark:bg-primary/20 text-primary border border-primary/20' 
        : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600'
    }`}>
      <span class="text-xs font-bold uppercase">{monthShort}</span>
      <span class="text-xl font-bold leading-none">{day}</span>
    </div>
    <div class="flex-1 min-w-0">
      {news.category && (
        <div class="flex items-center gap-2 mb-1">
          <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${categoryColor.bg} ${categoryColor.text} ${categoryColor.darkBg} ${categoryColor.darkText} uppercase tracking-wide`}>
            {news.category}
          </span>
        </div>
      )}
      <h3 class="text-base font-semibold text-slate-900 dark:text-white truncate">{news.title}</h3>
      <div class="prose prose-sm max-w-none text-slate-500 dark:text-slate-400 text-sm mt-1 line-clamp-2" set:html={htmlContent}></div>
    </div>
  </article>
)}
