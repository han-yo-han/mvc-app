---
import { marked } from 'marked';

interface Props {
  news: {
    title: string;
    date: string;
    content: string;
    important?: boolean;
    featured?: boolean;
    category?: string;
    image?: string;
    slug?: string;
  };
  featured?: boolean;
}

const { news, featured = false } = Astro.props;
const dateObj = new Date(news.date);
const formattedDate = dateObj.toLocaleDateString('ko-KR', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const monthShort = dateObj.toLocaleDateString('ko-KR', { month: 'short' });
const day = dateObj.getDate();

const htmlContent = await marked(news.content || '');

const categoryColors: Record<string, { bg: string; text: string }> = {
  'Youth': { bg: 'bg-amber/20', text: 'text-amber-dark' },
  'Building': { bg: 'bg-amber/20', text: 'text-amber-dark' },
  'Community': { bg: 'bg-forest/20', text: 'text-forest' },
  'Service': { bg: 'bg-forest/20', text: 'text-forest' },
  'Event': { bg: 'bg-forest', text: 'text-cream' },
};

const categoryColor = news.category ? categoryColors[news.category] || categoryColors['Event'] : categoryColors['Event'];
const defaultImage = 'https://lh3.googleusercontent.com/aida-public/AB6AXuDwVFwcFVHohR2bALgDmUdUssZ6_ys1qlxMudH86vFq2iNlQGve0_mtImRZnYDno3zKdgM46Pk17QZ0lbJAHHmsvaqCqODdh3OZ8sp0ddvli99DKpLoipnnaWSIx1Tv2xM2D-J9WBs8lHJ-WImlS7aoGqTla0cQkSJY7u9kRKPmWjTWMJ0Klsfsr0sQJbJEHsLm95Gu36-uUARohj0L27GZKF5xfxIS3Rxo9kulHp8O89aGXdlLWl0oELbtBxNiyNKITdzLX6X0GeSd';
---

{featured ? (
  <div class="group relative overflow-hidden rounded-2xl bg-cream shadow-soft transition-all hover:shadow-card border border-border/60">
    <div class="aspect-[16/9] w-full bg-surface relative overflow-hidden">
      <img 
        alt={news.title} 
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
        src={news.image || defaultImage}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 to-transparent"></div>
      {news.category && (
        <span class={`absolute top-4 left-4 ${categoryColor.bg} ${categoryColor.text} text-xs font-bold px-3 py-1.5 rounded-lg uppercase tracking-wide`}>
          {news.category}
        </span>
      )}
    </div>
    <div class="p-8">
      <h3 class="font-display text-2xl font-semibold text-charcoal leading-tight mb-3">{news.title}</h3>
      <div class="prose prose-sm max-w-none text-ink text-sm leading-relaxed mb-6 line-clamp-3" set:html={htmlContent}></div>
      <a 
        href={`/news/${news.slug || '#'}`}
        class="inline-flex items-center text-sm font-bold text-teal hover:text-teal/80 transition-colors"
      >
        자세히 보기 
        <span class="material-symbols-outlined ml-1 text-lg">arrow_forward</span>
      </a>
    </div>
  </div>
) : (
  <a href={`/news/${news.slug || '#'}`} class="flex gap-6 p-6 rounded-2xl bg-cream border border-border/60 shadow-soft hover:shadow-card hover:border-forest/20 transition-all cursor-pointer block">
    <div class={`shrink-0 flex flex-col items-center justify-center w-16 h-16 rounded-xl ${
      news.category === 'Youth' || news.important 
        ? 'bg-teal-100 text-teal border border-teal-200' 
        : 'bg-violet-50 text-violet border border-violet-200'
    }`}>
      <span class="text-xs font-bold uppercase">{monthShort}</span>
      <span class="font-display text-2xl font-semibold leading-none">{day}</span>
    </div>
    <div class="flex-1 min-w-0">
      {news.category && (
        <div class="flex items-center gap-2 mb-2">
          <span class={`px-2.5 py-1 rounded-lg text-xs font-bold ${categoryColor.bg} ${categoryColor.text} uppercase tracking-wide`}>
            {news.category}
          </span>
        </div>
      )}
      <h3 class="font-display text-xl font-semibold text-charcoal truncate">{news.title}</h3>
      <div class="prose prose-sm max-w-none text-muted text-sm mt-1 line-clamp-2" set:html={htmlContent}></div>
    </div>
  </a>
)}
