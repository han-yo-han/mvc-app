---
interface Props {
  images: { src: string; alt: string }[];
  maxCount?: number;
}

const { images, maxCount } = Astro.props;
const displayImages = maxCount ? images.slice(0, maxCount) : images;
const id = 'photo-strip-slider';
const n = displayImages.length;
const trackImages = n > 1 ? [displayImages[n - 1], ...displayImages, displayImages[0]] : displayImages;
---

<div id={id} class="carousel relative w-full" role="region" aria-label="사역/예배 현장 슬라이드">
  <div class="relative w-full overflow-hidden">
    <div class="carousel-viewport overflow-hidden py-12 lg:py-16">
      <div class="carousel-track flex items-center transition-transform duration-600 ease-out" data-carousel-track>
        {trackImages.map((img, i) => (
          <div class="slide flex-[0_0_33.333%] flex justify-center transition-transform duration-600 ease-out transition-opacity duration-600" data-slide-index={i}>
            <div class="w-[80%] rounded-2xl overflow-hidden border-2 border-forest/10 shadow-soft">
              <img src={img.src} alt={img.alt} class="w-full aspect-[4/3] object-cover" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            </div>
          </div>
        ))}
      </div>
    </div>

    {n > 1 && (
      <div class="absolute inset-y-0 left-0 right-0 flex items-center justify-between px-2 pointer-events-none">
        <button type="button" class="pointer-events-auto w-10 h-10 rounded-full bg-white/95 shadow-card flex items-center justify-center text-charcoal hover:bg-white transition-colors" aria-label="이전" data-carousel-prev>
          <span class="material-symbols-outlined text-xl">chevron_left</span>
        </button>
        <button type="button" class="pointer-events-auto w-10 h-10 rounded-full bg-white/95 shadow-card flex items-center justify-center text-charcoal hover:bg-white transition-colors" aria-label="다음" data-carousel-next>
          <span class="material-symbols-outlined text-xl">chevron_right</span>
        </button>
      </div>
    )}

    <div class="flex flex-col items-center justify-center py-6 gap-3">
      <span class="text-sm font-semibold text-charcoal text-center" data-carousel-caption>
        {displayImages[0]?.alt}
      </span>
      {n > 1 && (
        <div class="flex gap-1.5" data-carousel-dots>
          {displayImages.map((_, i) => (
            <button type="button" class={`w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-forest' : 'bg-forest/30 hover:bg-forest/50'}`} aria-label={`${i + 1}번째`} data-dot-index={i}></button>
          ))}
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .carousel-viewport {
    overflow: hidden;
  }
  .carousel-track {
    display: flex;
    align-items: center;
  }
  .slide {
    flex: 0 0 33.333%;
    display: flex;
    justify-content: center;
  }
  .slide.small {
    transform: scale(0.75);
    opacity: 0.65;
  }
  .slide.active {
    transform: scale(1.08);
    opacity: 1;
  }
</style>

{n > 1 && (
  <script define:vars={{ n, captions: displayImages.map(i => i.alt) }}>
    (function() {
      const container = document.getElementById('photo-strip-slider');
      if (!container || n < 2) return;

      const slides = container.querySelectorAll('.slide');
      const track = container.querySelector('[data-carousel-track]');
      const prevBtn = container.querySelector('[data-carousel-prev]');
      const nextBtn = container.querySelector('[data-carousel-next]');
      const captionEl = container.querySelector('[data-carousel-caption]');
      const dots = container.querySelectorAll('[data-dot-index]');

      let current = 1;
      let autoplayTimer = null;

      function updateCarousel() {
        slides.forEach(slide => {
          slide.classList.remove('active', 'small');
        });

        slides[current].classList.add('active');
        if (slides[current - 1]) slides[current - 1].classList.add('small');
        if (slides[current + 1]) slides[current + 1].classList.add('small');

        const offset = -((current - 1) * (100 / 3));
        track.style.transform = `translateX(${offset}%)`;
      }

      function updateCaption() {
        const idx = current - 1;
        if (captionEl && captions[idx] !== undefined) captionEl.textContent = captions[idx];
        dots.forEach((d, i) => {
          d.classList.toggle('bg-forest', i === idx);
          d.classList.toggle('bg-forest/30', i !== idx);
        });
      }

      function nextSlide() {
        current++;
        if (current >= slides.length - 1) {
          track.style.transition = 'none';
          current = 1;
          updateCarousel();
          updateCaption();
          requestAnimationFrame(() => {
            track.style.transition = 'transform 0.6s ease-out';
          });
        } else {
          updateCarousel();
          updateCaption();
        }
      }

      function prevSlide() {
        current--;
        if (current <= 0) {
          track.style.transition = 'none';
          current = slides.length - 2;
          updateCarousel();
          updateCaption();
          requestAnimationFrame(() => {
            track.style.transition = 'transform 0.6s ease-out';
          });
        } else {
          updateCarousel();
          updateCaption();
        }
      }

      function startAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
        autoplayTimer = setInterval(nextSlide, 3000);
      }

      track.style.transition = 'transform 0.6s ease-out';
      updateCarousel();
      updateCaption();

      prevBtn?.addEventListener('click', () => { prevSlide(); startAutoplay(); });
      nextBtn?.addEventListener('click', () => { nextSlide(); startAutoplay(); });
      dots.forEach((d, i) => d.addEventListener('click', () => {
        current = i + 1;
        updateCarousel();
        updateCaption();
        startAutoplay();
      }));

      container.addEventListener('mouseenter', () => { if (autoplayTimer) clearInterval(autoplayTimer); });
      container.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    })();
  </script>
)}