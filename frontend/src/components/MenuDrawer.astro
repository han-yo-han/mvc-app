---
const navItems = [
  { href: '/', label: '홈', icon: 'home' },
  { href: '/about', label: '교회소개', icon: 'info' },
  { href: '/worship', label: '예배안내', icon: 'calendar_month' },
  { href: '/sermons', label: '설교', icon: 'library_books', preventNav: true },
  { href: '/news', label: '교회소식', icon: 'newspaper', preventNav: true },
  { href: '/location', label: '오시는길', icon: 'location_on' },
  { href: '/newcomer', label: '방문안내', icon: 'person_add' },
];
---

<div id="menu-drawer" class="fixed inset-0 z-[100] hidden">
  <div id="menu-backdrop" class="absolute inset-0 bg-charcoal/60 backdrop-blur-sm transition-opacity"></div>
  
  <div id="menu-content" class="absolute left-0 top-0 h-full w-80 max-w-[85vw] bg-cream shadow-2xl transform -translate-x-full transition-transform duration-300 ease-out">
    <div class="flex flex-col h-full">
      <div class="flex items-center justify-between p-6 border-b border-border/80">
        <h2 class="font-display text-2xl font-semibold text-charcoal">메뉴</h2>
        <button id="menu-close" class="p-2 rounded-lg hover:bg-surface transition-colors"
          aria-label="메뉴 닫기">
          <span class="material-symbols-outlined text-charcoal">close</span>
        </button>
      </div>
      
      <nav class="flex-1 overflow-y-auto p-4">
        <ul class="space-y-1">
          {navItems.map((item) => (
            <li>
              <a
                href={item.preventNav ? '#' : item.href}
                class="flex items-center gap-4 p-4 rounded-xl hover:bg-surface transition-colors group"
                onclick={item.preventNav ? "event.preventDefault(); alert('준비중입니다.');" : undefined}
              >
                <span class="material-symbols-outlined text-2xl text-muted group-hover:text-accent transition-colors">
                  {item.icon}
                </span>
                <span class="font-medium text-charcoal">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      
      <div class="p-4 border-t border-border/80">
        <h3 class="font-display text-lg font-semibold text-charcoal text-center">선교비전교회</h3>
      </div>
    </div>
  </div>
</div>

<script>
  const drawer = document.getElementById('menu-drawer');
  const backdrop = document.getElementById('menu-backdrop');
  const content = document.getElementById('menu-content');
  const closeBtn = document.getElementById('menu-close');
  
  function openMenu() {
    if (drawer) {
      drawer.classList.remove('hidden');
      drawer.offsetHeight;
      content?.classList.remove('-translate-x-full');
      document.body.style.overflow = 'hidden';
    }
  }
  
  function closeMenu() {
    if (content) {
      content.classList.add('-translate-x-full');
      setTimeout(() => {
        drawer?.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }
  }
  
  backdrop?.addEventListener('click', closeMenu);
  closeBtn?.addEventListener('click', closeMenu);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer?.classList.contains('hidden')) {
      closeMenu();
    }
  });
  
  window.openMenu = openMenu;
</script>
