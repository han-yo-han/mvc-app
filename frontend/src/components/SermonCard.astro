---
interface Props {
  sermon: {
    title: string;
    date: string;
    scripture: string;
    speaker?: string;
    link: string;
    thumbnail?: string;
    category?: string;
    description?: string;
    duration?: string;
    serviceType?: string;
  };
}

const { sermon } = Astro.props;
const dateObj = new Date(sermon.date);
const formattedDate = dateObj.toLocaleDateString('ko-KR', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const formatDuration = (duration?: string) => {
  if (!duration) return '42:15';
  if (duration.includes(':')) return duration;
  const seconds = parseInt(duration);
  if (!isNaN(seconds)) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }
  return duration;
};

const serviceType = sermon.serviceType || sermon.category || '주일예배';
const duration = formatDuration(sermon.duration);
const thumbnail = sermon.thumbnail || 'https://lh3.googleusercontent.com/aida-public/AB6AXuDgn9ss445to1dkK6sJ7fq49U-phnJ21ki8JA4QwCyaK04D6U5N-ccOAss1SwnGFeq7ys99lNP68dvdhKW4PXqYQDe-Pc_C6wDdEh1rKcLYNgFwxNYD4ZaO4oXS027Erqy9Xed6_jMpgPHOftm0-V7im81hTx6Eobled9nthDnzP7_hSDbnqiUAC2aBQBuMYL-UPpbcfW2G59LmBYgqFMUBVznRQAY0ipvakSFq_1_0yGAaYgVAmqsHNLsqLkv-zXJj0P0QPz8SbykW';
const description = sermon.description || '말씀으로 세워지는 믿음의 기초';
---

<article class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-teal-200/50 hover:border-teal-300 shadow-soft hover:shadow-card transition-all duration-300">
  <div class="relative w-full aspect-video overflow-hidden">
    <img 
      alt={sermon.title} 
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
      src={thumbnail}
    />
    <div class="absolute inset-0 bg-charcoal/10 group-hover:bg-charcoal/20 transition-colors"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <a 
        href={sermon.link}
        target="_blank"
        rel="noopener noreferrer"
        class="w-16 h-16 rounded-full bg-teal-100 flex items-center justify-center shadow-elevated text-teal hover:scale-110 transition-transform"
      >
        <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
      </a>
    </div>
    <div class="absolute bottom-3 right-3 px-2.5 py-1 bg-charcoal/70 backdrop-blur-md rounded-lg text-xs font-medium text-cream">
      {duration}
    </div>
  </div>
  <div class="p-6 flex flex-col gap-3">
    <div class="flex items-center gap-2 text-xs font-semibold text-teal uppercase tracking-wider">
      <span>{serviceType}</span>
      <span class="w-1 h-1 rounded-full bg-border"></span>
      <span class="text-muted">{formattedDate}</span>
    </div>
    <h2 class="font-display text-2xl font-semibold leading-tight text-charcoal">{sermon.title}</h2>
    <p class="text-sm text-muted line-clamp-2">
      {description}
    </p>
    <div class="flex items-center justify-between pt-2 mt-auto">
      <span class="text-xs font-medium text-charcoal bg-surface px-3 py-1.5 rounded-lg border border-border/60">{sermon.scripture}</span>
      <a 
        href={sermon.link}
        target="_blank"
        rel="noopener noreferrer"
        class="text-teal text-sm font-bold flex items-center gap-1 group/btn hover:gap-2 transition-all"
      >
        시청하기 
        <span class="material-symbols-outlined text-base transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
      </a>
    </div>
  </div>
</article>
