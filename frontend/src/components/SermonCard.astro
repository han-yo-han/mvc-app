---
interface Props {
  sermon: {
    title: string;
    date: string;
    scripture: string;
    speaker?: string;
    link: string;
    thumbnail?: string;
    category?: string;
    description?: string;
    duration?: string;
    serviceType?: string;
  };
}

const { sermon } = Astro.props;
const dateObj = new Date(sermon.date);
const formattedDate = dateObj.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

// Format duration (assuming it's in seconds or MM:SS format)
const formatDuration = (duration?: string) => {
  if (!duration) return '42:15';
  if (duration.includes(':')) return duration;
  // If it's a number in seconds, convert to MM:SS
  const seconds = parseInt(duration);
  if (!isNaN(seconds)) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }
  return duration;
};

const serviceType = sermon.serviceType || sermon.category || 'Sunday Service';
const duration = formatDuration(sermon.duration);
const thumbnail = sermon.thumbnail || 'https://lh3.googleusercontent.com/aida-public/AB6AXuDgn9ss445to1dkK6sJ7fq49U-phnJ21ki8JA4QwCyaK04D6U5N-ccOAss1SwnGFeq7ys99lNP68dvdhKW4PXqYQDe-Pc_C6wDdEh1rKcLYNgFwxNYD4ZaO4oXS027Erqy9Xed6_jMpgPHOftm0-V7im81hTx6Eobled9nthDnzP7_hSDbnqiUAC2aBQBuMYL-UPpbcfW2G59LmBYgqFMUBVznRQAY0ipvakSFq_1_0yGAaYgVAmqsHNLsqLkv-zXJj0P0QPz8SbykW';
const description = sermon.description || 'Understanding the foundations of belief through the lens of scripture.';
---

<article class="group flex flex-col bg-white dark:bg-white/5 rounded-xl overflow-hidden shadow-[0_2px_8px_rgba(0,0,0,0.04)] dark:shadow-none border border-black/5 dark:border-white/10 transition-transform active:scale-[0.99]">
  <div class="relative w-full aspect-video overflow-hidden">
    <img 
      alt={sermon.title} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
      src={thumbnail}
    />
    <div class="absolute inset-0 bg-black/10 group-hover:bg-black/20 transition-colors"></div>
    <div class="absolute inset-0 flex items-center justify-center opacity-90 group-hover:opacity-100 transition-opacity">
      <a 
        href={sermon.link}
        target="_blank"
        rel="noopener noreferrer"
        class="w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-lg text-primary hover:scale-110 transition-transform"
      >
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
      </a>
    </div>
    <div class="absolute bottom-2 right-2 px-2 py-1 bg-black/60 backdrop-blur-md rounded text-xs font-medium text-white">
      {duration}
    </div>
  </div>
  <div class="p-4 flex flex-col gap-2">
    <div class="flex items-center gap-2 text-xs font-medium text-primary uppercase tracking-wider">
      <span>{serviceType}</span>
      <span class="w-1 h-1 rounded-full bg-[#e7ebf3]"></span>
      <span>{formattedDate}</span>
    </div>
    <h2 class="font-serif text-2xl font-bold leading-tight text-[#0d121b] dark:text-white">{sermon.title}</h2>
    <p class="text-sm text-[#4c669a] line-clamp-2">
      {description}
    </p>
    <div class="flex items-center justify-between pt-2 mt-auto">
      <span class="text-xs font-medium text-[#0d121b] dark:text-gray-300 bg-[#f4f3ef] dark:bg-white/10 px-2 py-1 rounded">{sermon.scripture}</span>
      <a 
        href={sermon.link}
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary text-sm font-bold flex items-center gap-1 group/btn hover:gap-2 transition-all"
      >
        Listen / Watch 
        <span class="material-symbols-outlined text-[16px] transition-transform group-hover/btn:translate-x-1">arrow_forward</span>
      </a>
    </div>
  </div>
</article>
