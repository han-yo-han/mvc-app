---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import { getChurch, getContact, getLocation, getWorship } from '../lib/content.js';

const church = getChurch();
const contact = getContact();
const location = getLocation();
const worship = getWorship();
---

<Layout title="교회소개 - 선교비전교회">
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-cream to-sand text-charcoal antialiased">
    <PageHeader currentPath="/about" />

    <main class="flex-1 w-full max-w-page mx-auto px-4 lg:px-8 pt-6 lg:pt-8 pb-24 lg:pb-12">
      {church?.pastor && (
        <section class="flex flex-col items-center pt-12 lg:pt-16 pb-12">
          <div class="relative mb-8">
            <div class="absolute -inset-1 rounded-full bg-accent/10 blur-sm"></div>
            <img src={church.pastor.photo || '/images/pastor.png'} alt={church.pastor.name} class="relative h-36 w-36 overflow-hidden rounded-full border-4 border-cream shadow-elevated object-cover" />
          </div>
          <div class="text-center">
            <p class="mb-2 section-label">{church.pastor.title} 인사말</p>
            <h1 class="mb-4 font-display text-4xl font-semibold leading-tight text-charcoal">{church.pastor.name}</h1>
            <p class="mx-auto max-w-md text-lg leading-relaxed text-ink">
              "{church.pastor.greeting || '교회는 건물이 아니라 가족입니다. 믿음을 탐색하든 공동체를 찾든, 여기가 여러분의 자리입니다.'}"
            </p>
            <div class="mt-8 h-0.5 w-12 rounded-full bg-accent/30 mx-auto"></div>
          </div>
        </section>
      )}

      {(church?.vision || church?.mission) && (
        <section class="space-y-6 pb-12 scroll-reveal">
          {church.vision && (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-8 border border-border shadow-soft">
              <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">visibility</span>
              </div>
              <h2 class="mb-3 font-display text-2xl font-semibold text-charcoal">비전</h2>
              <p class="text-ink leading-relaxed">{church.vision}</p>
            </div>
          )}
          {church.mission && (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-8 border border-border shadow-soft">
              <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
              </div>
              <h2 class="mb-3 font-display text-2xl font-semibold text-charcoal">사명</h2>
              <p class="text-ink leading-relaxed">{church.mission}</p>
            </div>
          )}
        </section>
      )}

      {church?.history && church.history.length > 0 && (
        <section class="bg-white px-6 lg:px-8 py-10 rounded-2xl border border-border shadow-soft mb-8">
          <div class="mb-8 flex items-center justify-between">
            <h2 class="font-display text-2xl font-semibold text-charcoal">교회 연혁</h2>
            <span class="text-xs font-medium text-muted">설립 {church.history[0]?.year || '2010'}</span>
          </div>
          <div class="relative border-l-2 border-dashed border-border ml-3 space-y-10 pb-4">
            {church.history.map((item, index) => (
              <div class="relative pl-8">
                <div class={`absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-cream ${index === church.history.length - 1 ? 'bg-accent shadow-sm ring-4 ring-accent/10' : 'bg-muted-light'}`}></div>
                <span class={`mb-1 block text-sm font-bold ${index === church.history.length - 1 ? 'text-accent' : 'text-muted'}`}>{item.year}</span>
                <h3 class="mb-1 font-display text-lg font-semibold text-charcoal">{item.event}</h3>
                {item.description && <p class="text-sm text-ink">{item.description}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      {church?.denomination && (
        <section class="pb-6">
          <div class="rounded-2xl bg-white p-6 border border-border shadow-soft flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent/10 text-accent">
              <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">verified</span>
            </div>
            <div>
              <p class="section-label mb-1">소속 교단</p>
              <p class="font-display text-xl font-semibold text-charcoal">{church.denomination}</p>
            </div>
          </div>
        </section>
      )}

      {church?.missionWork && church.missionWork.length > 0 && (
        <section class="pb-6">
          <h2 class="font-display text-xl font-semibold text-charcoal mb-4 px-1">선교 사역 지원</h2>
          <div class="space-y-4">
            {church.missionWork.map((mission) => (
              <div class="rounded-2xl bg-white p-6 border border-border shadow-soft flex items-center gap-4">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                  <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">public</span>
                </div>
                <div>
                  <h3 class="font-display text-lg font-semibold text-charcoal">{mission.country}</h3>
                  <p class="text-sm text-muted">{mission.missionary}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {church?.evangelism?.streetEvangelism && (
        <section class="pb-6">
          <div class="rounded-2xl bg-white p-6 border border-border shadow-soft flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent/10 text-accent">
              <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">directions_walk</span>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold text-charcoal">노방전도</h3>
              <p class="text-sm text-muted">{church.evangelism.streetEvangelism}</p>
            </div>
          </div>
        </section>
      )}

      {church?.prayerRequests && church.prayerRequests.length > 0 && (
        <section class="pb-8">
          <h2 class="font-display text-xl font-semibold text-charcoal mb-4 px-1">공동 기도제목</h2>
          <div class="rounded-2xl bg-white/90 p-8 border border-accent/30 shadow-soft">
            <ul class="space-y-4">
              {church.prayerRequests.map((prayer) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-accent text-xl mt-0.5 shrink-0" style="font-variation-settings: 'FILL' 1;">favorite</span>
                  <p class="text-sm text-ink leading-relaxed">{prayer}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <section class="pb-8">
        <div class="rounded-2xl bg-charcoal p-10 text-center overflow-hidden relative">
          <div class="relative">
            <h2 class="mb-3 font-display text-3xl font-semibold text-cream">이번 주일, 함께해요</h2>
            <p class="mb-6 text-cream/70">매주 함께 예배드려요</p>
            <a href="/newcomer" class="inline-block rounded-lg bg-accent px-8 py-4 text-sm font-bold text-charcoal shadow-elevated transition-all hover:bg-accent-light">
              방문 안내
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer church={church} contact={contact} location={location} worship={worship} />
    <BottomNav currentPath="/about" />
    <MenuDrawer />
  </div>
</Layout>
