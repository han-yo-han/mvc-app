---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import { getChurch } from '../lib/content.js';

const church = getChurch();
---

<Layout title="교회소개 - 선교비전교회">
  <div class="flex flex-col min-h-screen bg-white text-text-main antialiased">
    <PageHeader currentPath="/about" />

    <main class="flex-1 w-full max-w-4xl mx-auto px-4 lg:px-8 pb-24 lg:pb-12">
      <!-- Pastor's Greeting -->
      {church?.pastor && (
        <section class="flex flex-col items-center px-6 pt-8 pb-10">
          <div class="relative mb-6">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-primary/30 to-accent-gold/40 blur-sm"></div>
            {church.pastor.photo ? (
              <img src={church.pastor.photo} alt={church.pastor.name} class="relative h-32 w-32 overflow-hidden rounded-full border-4 border-white shadow-soft object-cover" />
            ) : (
              <div class="relative h-32 w-32 overflow-hidden rounded-full border-4 border-white shadow-soft bg-gray-200 flex items-center justify-center">
                <span class="material-symbols-outlined text-4xl text-gray-400">person</span>
              </div>
            )}
          </div>
          <div class="text-center">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">{church.pastor.title} 인사말</p>
            <h1 class="mb-4 text-3xl font-bold leading-tight tracking-tight text-[#0d121b]">{church.pastor.name}</h1>
            {church.pastor.greeting ? (
              <p class="mx-auto max-w-xs text-base leading-relaxed text-gray-600">
                "{church.pastor.greeting}"
              </p>
            ) : (
              <p class="mx-auto max-w-xs text-base leading-relaxed text-gray-600">
                "교회는 건물이 아니라 가족입니다. 믿음을 탐색하든 공동체를 찾든, 여기가 여러분의 자리입니다."
              </p>
            )}
            <div class="mt-6 h-1 w-12 rounded-full bg-accent-gold/40 mx-auto"></div>
          </div>
        </section>
      )}

      <!-- Vision & Mission Cards -->
      {(church?.vision || church?.mission) && (
        <section class="space-y-4 px-4 pb-12">
          {church.vision && (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-soft transition-all hover:shadow-lg">
              <div class="absolute right-0 top-0 -mr-6 -mt-6 h-24 w-24 rounded-full bg-primary/5 transition-transform group-hover:scale-150"></div>
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                <span class="material-symbols-outlined">visibility</span>
              </div>
              <h2 class="mb-2 text-xl font-bold text-[#0d121b]">비전</h2>
              <p class="text-gray-600 leading-relaxed">{church.vision}</p>
            </div>
          )}
          {church.mission && (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-soft transition-all hover:shadow-lg">
              <div class="absolute right-0 top-0 -mr-6 -mt-6 h-24 w-24 rounded-full bg-accent-gold/10 transition-transform group-hover:scale-150"></div>
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-accent-gold/20 text-[#b39226]">
                <span class="material-symbols-outlined">volunteer_activism</span>
              </div>
              <h2 class="mb-2 text-xl font-bold text-[#0d121b]">사명</h2>
              <p class="text-gray-600 leading-relaxed">{church.mission}</p>
            </div>
          )}
        </section>
      )}

      <!-- History Timeline -->
      {church?.history && church.history.length > 0 && (
        <section class="bg-white px-6 py-10 mx-4 rounded-2xl shadow-soft mb-8">
          <div class="mb-8 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-[#0d121b]">교회 연혁</h2>
            <span class="text-xs font-medium text-gray-400">설립 {church.history[0]?.year || '2010'}</span>
          </div>
          <div class="relative border-l-2 border-dashed border-gray-200 ml-3 space-y-10 pb-4">
            {church.history.map((item, index) => (
              <div class="relative pl-8">
                <div class={`absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-white ${index === church.history.length - 1 ? 'bg-primary shadow-sm ring-4 ring-primary/10' : index === 0 ? 'bg-accent-gold shadow-sm' : 'bg-gray-300'}`}></div>
                <span class={`mb-1 block text-sm font-bold ${index === church.history.length - 1 ? 'text-primary' : index === 0 ? 'text-accent-gold' : 'text-gray-500'}`}>{item.year}</span>
                <h3 class="mb-1 text-lg font-bold text-[#0d121b]">{item.event}</h3>
                {item.description && (
                  <p class="text-sm text-gray-600">{item.description}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Denomination Info -->
      {church?.denomination && (
        <section class="px-4 pb-6">
          <div class="rounded-2xl bg-white p-5 shadow-soft border border-gray-100 flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <span class="material-symbols-outlined">verified</span>
            </div>
            <div>
              <p class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-1">소속 교단</p>
              <p class="font-bold text-[#0d121b]">{church.denomination}</p>
            </div>
          </div>
        </section>
      )}

      <!-- Mission Work -->
      {church?.missionWork && church.missionWork.length > 0 && (
        <section class="px-4 pb-6">
          <h2 class="text-lg font-bold text-[#0d121b] mb-4 px-1">선교 사역</h2>
          <div class="space-y-3">
            {church.missionWork.map((mission) => (
              <div class="rounded-2xl bg-white p-5 shadow-soft flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <span class="material-symbols-outlined">public</span>
                </div>
                <div>
                  <h3 class="font-bold text-[#0d121b]">{mission.country}</h3>
                  <p class="text-sm text-text-muted">{mission.missionary}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Evangelism -->
      {church?.evangelism?.streetEvangelism && (
        <section class="px-4 pb-6">
          <div class="rounded-2xl bg-white p-5 shadow-soft flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent-gold/20 text-[#b39226]">
              <span class="material-symbols-outlined">directions_walk</span>
            </div>
            <div>
              <h3 class="font-bold text-[#0d121b]">노방전도</h3>
              <p class="text-sm text-text-muted">{church.evangelism.streetEvangelism}</p>
            </div>
          </div>
        </section>
      )}

      <!-- Prayer Requests -->
      {church?.prayerRequests && church.prayerRequests.length > 0 && (
        <section class="px-4 pb-8">
          <h2 class="text-lg font-bold text-[#0d121b] mb-4 px-1">공동 기도제목</h2>
          <div class="rounded-2xl bg-white p-6 shadow-soft">
            <ul class="space-y-3">
              {church.prayerRequests.map((prayer) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-primary text-[18px] mt-0.5 shrink-0">favorite</span>
                  <p class="text-sm text-gray-600 leading-relaxed">{prayer}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Call to Action -->
      <section class="px-4 pb-8">
        <div class="rounded-2xl bg-primary p-8 text-center shadow-lg">
          <h2 class="mb-3 text-2xl font-bold text-white font-serif">이번 주일, 함께해요</h2>
          <p class="mb-6 text-blue-100">매주 함께 예배드려요</p>
          <a href="/newcomer" class="inline-block rounded-xl bg-white px-8 py-3.5 text-sm font-bold text-primary shadow-md transition-transform active:scale-95 hover:bg-gray-50">
            방문 안내
          </a>
        </div>
      </section>
    </main>

    <BottomNav currentPath="/about" />
    <MenuDrawer />
  </div>
</Layout>
