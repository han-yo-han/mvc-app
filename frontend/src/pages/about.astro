---
import Layout from '../layouts/Layout.astro';
import { getChurch } from '../lib/content.js';

const church = getChurch();
---

<Layout title="교회소개 - 선교비전교회">
  <div class="relative flex h-full w-full max-w-md flex-col bg-[#f8f9fc] shadow-2xl overflow-hidden mx-auto">
    <!-- Header -->
    <header class="sticky top-0 z-50 flex items-center justify-between bg-[#f8f9fc]/90 px-5 py-4 backdrop-blur-md">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <span class="material-symbols-outlined text-[20px]">church</span>
        </div>
        <span class="text-lg font-bold tracking-tight text-[#0d121b]">{church?.name || 'Mission Vision'}</span>
      </div>
      <a href="/" class="flex h-10 w-10 items-center justify-center rounded-full text-[#0d121b] hover:bg-black/5">
        <span class="material-symbols-outlined">menu</span>
      </a>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto no-scrollbar pb-24">
      <!-- Pastor's Greeting -->
      {church?.pastor && (
        <section class="flex flex-col items-center px-6 pt-6 pb-10">
          <div class="relative mb-6">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-primary/30 to-accent-gold/40 blur-sm"></div>
            {church.pastor.photo ? (
              <img src={church.pastor.photo} alt={church.pastor.name} class="relative h-32 w-32 overflow-hidden rounded-full border-4 border-white shadow-soft object-cover" />
            ) : (
              <div class="relative h-32 w-32 overflow-hidden rounded-full border-4 border-white shadow-soft bg-gray-200 flex items-center justify-center">
                <span class="material-symbols-outlined text-4xl text-gray-400">person</span>
              </div>
            )}
          </div>
          <div class="text-center">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">A Note from {church.pastor.title}</p>
            <h1 class="mb-4 text-3xl font-bold leading-tight tracking-tight text-[#0d121b]">{church.pastor.name}</h1>
            {church.pastor.greeting ? (
              <p class="mx-auto max-w-xs text-base leading-relaxed text-gray-600">
                "{church.pastor.greeting}"
              </p>
            ) : (
              <p class="mx-auto max-w-xs text-base leading-relaxed text-gray-600">
                "We believe that church isn't just a building, it's a family. Whether you're exploring faith or looking for a community, you belong here."
              </p>
            )}
            <div class="mt-6 h-1 w-12 rounded-full bg-accent-gold/40 mx-auto"></div>
          </div>
        </section>
      )}

      <!-- Vision & Mission Cards -->
      {(church?.vision || church?.mission) && (
        <section class="space-y-4 px-4 pb-12">
          {church.vision && (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-soft transition-all hover:shadow-lg">
              <div class="absolute right-0 top-0 -mr-6 -mt-6 h-24 w-24 rounded-full bg-primary/5 transition-transform group-hover:scale-150"></div>
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                <span class="material-symbols-outlined">visibility</span>
              </div>
              <h2 class="mb-2 text-xl font-bold text-[#0d121b]">Our Vision</h2>
              <p class="text-gray-600 leading-relaxed">{church.vision}</p>
            </div>
          )}
          {church.mission && (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-soft transition-all hover:shadow-lg">
              <div class="absolute right-0 top-0 -mr-6 -mt-6 h-24 w-24 rounded-full bg-accent-gold/10 transition-transform group-hover:scale-150"></div>
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-accent-gold/20 text-[#b39226]">
                <span class="material-symbols-outlined">volunteer_activism</span>
              </div>
              <h2 class="mb-2 text-xl font-bold text-[#0d121b]">Our Mission</h2>
              <p class="text-gray-600 leading-relaxed">{church.mission}</p>
            </div>
          )}
        </section>
      )}

      <!-- History Timeline -->
      {church?.history && church.history.length > 0 && (
        <section class="bg-white px-6 py-10">
          <div class="mb-8 flex items-center justify-between">
            <h2 class="text-2xl font-bold text-[#0d121b]">Our Journey</h2>
            <span class="text-xs font-medium text-gray-400">EST. {church.history[0]?.year || '2010'}</span>
          </div>
          <div class="relative border-l-2 border-dashed border-gray-200 ml-3 space-y-10 pb-4">
            {church.history.map((item, index) => (
              <div class="relative pl-8">
                <div class={`absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-white ${index === church.history.length - 1 ? 'bg-primary shadow-sm ring-4 ring-primary/10' : index === 0 ? 'bg-accent-gold shadow-sm' : 'bg-gray-300'}`}></div>
                <span class={`mb-1 block text-sm font-bold ${index === church.history.length - 1 ? 'text-primary' : index === 0 ? 'text-accent-gold' : 'text-gray-500'}`}>{item.year}</span>
                <h3 class="mb-1 text-lg font-bold text-[#0d121b]">{item.event}</h3>
                {item.description && (
                  <p class="text-sm text-gray-600">{item.description}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Call to Action -->
      <section class="px-6 py-12 text-center">
        <h2 class="mb-3 text-2xl font-bold text-[#0d121b]">Join us this Sunday</h2>
        <p class="mb-8 text-gray-600">Services at 9:00 AM & 11:00 AM</p>
        <a href="/location" class="block w-full rounded-xl bg-primary px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary/30 transition-transform active:scale-95">
          Plan Your Visit
        </a>
        <div class="mt-6 flex justify-center gap-6">
          <a class="text-gray-400 hover:text-primary transition-colors" href="#">
            <span class="sr-only">Instagram</span>
            <svg aria-hidden="true" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path clip-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.468 2.373c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" fill-rule="evenodd"></path>
            </svg>
          </a>
          <a class="text-gray-400 hover:text-primary transition-colors" href="#">
            <span class="sr-only">Facebook</span>
            <svg aria-hidden="true" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path clip-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" fill-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </section>
    </main>

    <!-- Bottom Navigation Bar -->
    <div class="absolute bottom-0 left-0 right-0 border-t border-[#e7ebf3] bg-[#f8f9fc] px-4 pb-6 pt-3">
      <div class="flex justify-between gap-2">
        <a class="flex flex-1 flex-col items-center justify-end gap-1 text-[#4c669a] hover:text-primary transition-colors" href="/">
          <div class="flex h-8 items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">home</span>
          </div>
          <p class="text-xs font-medium leading-normal tracking-[0.015em]">Home</p>
        </a>
        <a class="flex flex-1 flex-col items-center justify-end gap-1 rounded-full text-primary" href="/about">
          <div class="flex h-8 items-center justify-center">
            <span class="material-symbols-outlined text-[24px] font-variation-settings-'FILL'1">info</span>
          </div>
          <p class="text-xs font-bold leading-normal tracking-[0.015em]">About</p>
        </a>
        <a class="flex flex-1 flex-col items-center justify-end gap-1 text-[#4c669a] hover:text-primary transition-colors" href="/news">
          <div class="flex h-8 items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">calendar_today</span>
          </div>
          <p class="text-xs font-medium leading-normal tracking-[0.015em]">Events</p>
        </a>
        <a class="flex flex-1 flex-col items-center justify-end gap-1 text-[#4c669a] hover:text-primary transition-colors" href="/sermons">
          <div class="flex h-8 items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">play_circle</span>
          </div>
          <p class="text-xs font-medium leading-normal tracking-[0.015em]">Sermons</p>
        </a>
      </div>
    </div>
  </div>
</Layout>
