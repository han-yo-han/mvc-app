---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import MenuDrawer from '../../components/MenuDrawer.astro';
import { getAllNews, getChurch, getContact, getLocation, getWorship } from '../../lib/content.js';
import NewsCard from '../../components/NewsCard.astro';

const news = getAllNews();
const church = getChurch();
const contact = getContact();
const location = getLocation();
const worship = getWorship();

const featuredNews = news && news.length > 0 ? news.find(n => n.featured) || news[0] : null;
const latestNews = news && news.length > 0 ? news.filter(n => !n.featured || n !== featuredNews).slice(0, 4) : [];
---

<Layout title="교회소식 - 선교비전교회">
  <script>
    alert('준비중입니다.');
    window.location.href = '/';
  </script>
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-cream to-sand text-charcoal antialiased">
    <PageHeader currentPath="/news" />

    <main class="flex-1 w-full max-w-page mx-auto px-4 lg:px-8 pt-6 lg:pt-8 pb-24 lg:pb-12 space-y-12">
      {featuredNews && (
        <section class="scroll-reveal">
          <div class="flex items-center justify-between mb-4 px-1">
            <span class="section-label">주요 소식</span>
            <span class="text-xs text-muted">
              {new Date(featuredNews.date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          </div>
          <NewsCard news={featuredNews} featured={true} />
        </section>
      )}

      <section class="scroll-reveal">
        <div class="flex items-center justify-between mb-6 px-1">
          <h2 class="font-display text-2xl font-semibold text-charcoal">최근 소식</h2>
        </div>
        <div class="space-y-4">
          {latestNews.length > 0 ? (
            latestNews.map((item) => (
              <NewsCard news={item} featured={false} />
            ))
          ) : (
            <div class="text-center py-24">
              <span class="material-symbols-outlined text-8xl text-muted-light/50 mb-6">newspaper</span>
              <p class="text-muted text-lg">더 많은 소식이 곧 업데이트됩니다.</p>
            </div>
          )}
        </div>
      </section>
    </main>

    <Footer church={church} contact={contact} location={location} worship={worship} />
    <BottomNav currentPath="/news" />
    <MenuDrawer />
  </div>
</Layout>
