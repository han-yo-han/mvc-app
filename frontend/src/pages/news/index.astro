---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BottomNav from '../../components/BottomNav.astro';
import MenuDrawer from '../../components/MenuDrawer.astro';
import { getAllNews, getChurch } from '../../lib/content.js';
import NewsCard from '../../components/NewsCard.astro';

const news = getAllNews();
const church = getChurch();

const featuredNews = news && news.length > 0 ? news.find(n => n.featured) || news[0] : null;
const latestNews = news && news.length > 0 ? news.filter(n => !n.featured || n !== featuredNews).slice(0, 4) : [];
---

<Layout title="교회소식 - 선교비전교회">
  <div class="flex flex-col min-h-screen bg-white text-text-main antialiased">
    <PageHeader currentPath="/news" />

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 lg:px-8 py-6 pb-24 lg:pb-12 space-y-8">
      <!-- Featured Section -->
      {featuredNews && (
        <section>
          <div class="flex items-center justify-between mb-3 px-1">
            <h2 class="text-xs font-bold text-primary uppercase tracking-wider">주요 소식</h2>
            <span class="text-xs text-gray-400">
              {new Date(featuredNews.date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          </div>
          <NewsCard news={featuredNews} featured={true} />
        </section>
      )}

      <!-- Latest Updates List -->
      <section>
        <div class="flex items-center justify-between mb-4 px-1">
          <h2 class="text-lg font-bold text-[#0d121b]">최근 소식</h2>
        </div>
        <div class="space-y-4">
          {latestNews.length > 0 ? (
            latestNews.map((item) => (
              <NewsCard news={item} featured={false} />
            ))
          ) : (
            <div class="text-center py-16">
              <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">newspaper</span>
              <p class="text-text-muted text-lg">더 많은 소식이 곧 업데이트됩니다.</p>
            </div>
          )}
        </div>
      </section>
    </main>

    <BottomNav currentPath="/news" />
    <MenuDrawer />
  </div>
</Layout>
