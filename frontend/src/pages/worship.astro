---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import { getWorship, getChurch, getContact, getLocation } from '../lib/content.js';

const worship = getWorship();
const church = getChurch();
const contact = getContact();
const location = getLocation();
---

<Layout title="예배안내 - 선교비전교회">
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-cream to-sand text-charcoal antialiased">
    <PageHeader currentPath="/worship" />

    <main class="flex-1 w-full max-w-page mx-auto px-4 lg:px-8 pt-6 lg:pt-8 pb-24 lg:pb-12">
      <section class="mt-6 lg:mt-8 pb-8">
        <span class="section-label block mb-4">함께 예배해요</span>
        <h1 class="font-display text-3xl lg:text-4xl font-semibold text-charcoal tracking-tight mb-2">예배 안내</h1>
        <p class="text-muted mb-6">매주 함께 예배하고 교제해요</p>
        <hr class="h-px border-0 bg-accent/25 max-w-3xl" aria-hidden="true" />
      </section>

      <section class="py-10 space-y-6 scroll-reveal">
        {worship?.schedules && worship.schedules.length > 0 ? (
          worship.schedules.map((schedule) => (
            <div class="group relative overflow-hidden rounded-2xl bg-white p-8 border border-border shadow-soft transition-all hover:border-accent/30 hover:shadow-card">
              <div class="flex items-start gap-6">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                  <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">event</span>
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-3">
                    <h2 class="font-display text-2xl font-semibold text-charcoal">{schedule.type}</h2>
                    {schedule.onlineAvailable && (
                      <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-xs font-semibold rounded-full">
                        온라인 가능
                      </span>
                    )}
                  </div>
                  <div class="space-y-2">
                    <div class="flex items-center gap-2 text-muted">
                      <span class="material-symbols-outlined text-lg">schedule</span>
                      <span class="font-medium">{schedule.time}</span>
                    </div>
                    <div class="flex items-center gap-2 text-muted">
                      <span class="material-symbols-outlined text-lg">location_on</span>
                      <span>{schedule.location}</span>
                    </div>
                    {schedule.description && (
                      <p class="text-sm text-ink mt-2">{schedule.description}</p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        ) : (
          <div class="text-center py-16">
            <span class="material-symbols-outlined text-7xl text-muted-light mb-4">event_busy</span>
            <p class="text-muted">예배 시간 정보를 준비 중입니다.</p>
          </div>
        )}
      </section>

      {worship?.onlineLink && (
        <section class="pb-6">
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-pastel-orange to-pastel-yellow p-8 border border-accent/30 shadow-elevated">
            <div class="flex items-center gap-4 mb-6">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-cream/40">
                <span class="material-symbols-outlined text-3xl text-charcoal" style="font-variation-settings: 'FILL' 1;">smart_display</span>
              </div>
              <div>
                <h2 class="font-display text-2xl font-semibold text-charcoal">온라인 예배</h2>
                <p class="text-sm text-charcoal/80">실시간 스트리밍</p>
              </div>
            </div>
            <a
              href={worship.onlineLink}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full rounded-lg bg-cream text-charcoal px-6 py-4 text-base font-bold text-center shadow-card hover:bg-white transition-all"
            >
              온라인으로 시청하기
            </a>
          </div>
        </section>
      )}

      {worship?.youtubeChannel && (
        <section class="pb-6">
          <div class="relative overflow-hidden rounded-2xl bg-white p-8 border border-border shadow-soft">
            <div class="flex items-center gap-4 mb-6">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">smart_display</span>
              </div>
              <div>
                <h2 class="font-display text-2xl font-semibold text-charcoal">YouTube 채널</h2>
                <p class="text-sm text-muted">매주 설교 업로드</p>
              </div>
            </div>
            <a
              href={worship.youtubeChannel}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full rounded-lg bg-[#FF0000] hover:bg-[#CC0000] px-6 py-4 text-base font-bold text-white text-center shadow-card transition-all"
            >
              YouTube 구독하기
            </a>
          </div>
        </section>
      )}

      {worship?.training && worship.training.length > 0 && (
        <section class="pb-6">
          <h2 class="font-display text-xl font-semibold text-charcoal mb-4 px-1">훈련 및 양육</h2>
          <div class="space-y-4">
            {worship.training.map((item) => (
              <div class="rounded-2xl bg-white p-6 border border-border shadow-soft flex items-center gap-4">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                  <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">school</span>
                </div>
                <div>
                  <h3 class="font-display text-lg font-semibold text-charcoal">{item.name}</h3>
                  <p class="text-sm text-muted">{item.time}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {worship?.firstTimeVisitorGuide && (
        <section class="pb-8">
          <div class="rounded-2xl bg-white p-8 border border-border shadow-soft">
            <div class="flex items-start gap-6">
              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">info</span>
              </div>
              <div class="flex-1">
                <h2 class="font-display text-xl font-semibold text-charcoal mb-2">처음 방문하시나요?</h2>
                <p class="text-sm text-ink leading-relaxed mb-3">{worship.firstTimeVisitorGuide.description}</p>
                {worship.firstTimeVisitorGuide.infoDeskLocation && (
                  <div class="flex items-center gap-2 text-sm text-muted">
                    <span class="material-symbols-outlined text-lg">place</span>
                    <span>안내 데스크: {worship.firstTimeVisitorGuide.infoDeskLocation}</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer church={church} contact={contact} location={location} worship={worship} />
    <BottomNav currentPath="/worship" />
    <MenuDrawer />
  </div>
</Layout>
