---
import Layout from '../layouts/Layout.astro';
import { getLocation, getContact, getChurch } from '../lib/content.js';
import MenuDrawer from '../components/MenuDrawer.astro';

const location = getLocation();
const contact = getContact();
const church = getChurch();
---

<Layout title="Location & Map - Mission Vision Church">
  <div class="bg-background-light dark:bg-background-dark text-text-main dark:text-white font-display antialiased flex flex-col min-h-screen">
    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col pb-20">
      <!-- Header -->
      <header class="sticky top-0 z-20 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-sm border-b border-neutral-light dark:border-neutral-dark px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center justify-center p-2 rounded-full hover:bg-neutral-light dark:hover:bg-neutral-dark text-text-main dark:text-white transition-colors">
          <span class="material-symbols-outlined" style="font-size: 24px;">arrow_back</span>
        </a>
        <h1 class="text-lg font-bold text-center flex-1 pr-10">Location</h1>
      </header>

      <!-- Map Section -->
      <section class="relative w-full h-[40vh] min-h-[300px] bg-neutral-light dark:bg-neutral-dark">
        <!-- Map Placeholder Image -->
        <div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD56pzvI80_uUC_Himmxt1IDeKPPcX7jn6o0ODWzMi1MDFxvz6VZaTtid2DG77jeAKXG6L4BMHeSRP1IGZd2L2Ugefk3vw2BeOdDO6_vImagTwhGHdlOok338PzeTvQs_adSpVSobXWoEoilourthLhJ3EcoQoSO5W9hoBM1l2a8lFF_-Xcq7_5WTpqQTvHyu_u_tUpaVnPrz7jz1G27qR5GSGT2ITVHv2_hcY1fm3b0_A05wUSNQDhIlFyhRg0xh1mzOH2wES-QcsL');">
          <!-- Overlay Gradient for better text visibility if needed -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>
        <!-- Floating Action Button for Directions -->
        <div class="absolute bottom-6 right-6 z-10">
          <button 
            onclick={location?.coordinates ? `window.open('https://www.google.com/maps/dir/?api=1&destination=${location.coordinates.lat},${location.coordinates.lng}', '_blank')` : undefined}
            class="flex items-center justify-center size-14 rounded-full bg-primary text-primary-content shadow-lg shadow-primary/30 hover:scale-105 active:scale-95 transition-all"
          >
            <span class="material-symbols-outlined" style="font-size: 28px;">directions</span>
          </button>
        </div>
      </section>

      <!-- Content Container -->
      <div class="px-5 py-6 space-y-8 -mt-4 bg-background-light dark:bg-background-dark rounded-t-3xl relative z-10 shadow-[0_-4px_20px_rgba(0,0,0,0.05)]">
        <!-- Address Card -->
        <section>
          <div class="flex items-start justify-between mb-2">
            <div>
              <h2 class="text-2xl font-bold text-text-main dark:text-white tracking-tight">{church?.name || 'Mission Vision Church'}</h2>
              <p class="text-sm text-text-secondary dark:text-gray-400 mt-1">Main Sanctuary</p>
            </div>
            <span class="inline-flex items-center justify-center px-2.5 py-1 rounded bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-bold uppercase tracking-wide">Open</span>
          </div>
          <div class="mt-4 p-4 rounded-xl bg-neutral-light dark:bg-neutral-dark flex items-center justify-between gap-3">
            <div class="flex items-start gap-3 flex-1">
              <span class="material-symbols-outlined text-primary mt-0.5" style="font-size: 22px;">location_on</span>
              <div class="text-sm font-medium text-text-main dark:text-gray-200 leading-relaxed">
                {location?.address?.full || '123 Faith Street, Gangnam-gu'}
                <br/>
                {location?.address?.detail || 'Seoul, South Korea, 06000'}
              </div>
            </div>
            <button 
              aria-label="Copy Address" 
              class="p-2 text-primary hover:bg-primary/10 rounded-lg transition-colors flex-shrink-0"
              onclick={`navigator.clipboard.writeText('${location?.address?.full || '123 Faith Street, Gangnam-gu'} ${location?.address?.detail || 'Seoul, South Korea, 06000'}')`}
            >
              <span class="material-symbols-outlined" style="font-size: 20px;">content_copy</span>
            </button>
          </div>
        </section>

        <!-- Public Transport -->
        <section>
          <h3 class="text-lg font-bold text-text-main dark:text-white mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-text-secondary" style="font-size: 20px;">commute</span>
            Public Transport
          </h3>
          <div class="space-y-3">
            <!-- Subway Item -->
            {location?.subway && location.subway.length > 0 ? (
              location.subway.map((subway, index) => (
                <div key={index} class="flex gap-4 p-4 border border-neutral-light dark:border-neutral-dark/50 rounded-xl hover:border-primary/30 transition-colors">
                  <div class="size-10 rounded-lg bg-[#009D3E]/10 flex items-center justify-center text-[#009D3E] flex-shrink-0">
                    <span class="material-symbols-outlined" style="font-size: 24px;">subway</span>
                  </div>
                  <div>
                    <p class="font-bold text-text-main dark:text-white">Subway Line {subway.line || '2'}</p>
                    <p class="text-sm text-text-secondary dark:text-gray-400 mt-0.5">
                      {subway.station || 'Green Station'}, {subway.exit || 'Exit 4'} ({subway.walkingTime || '5 min walk'})
                    </p>
                  </div>
                </div>
              ))
            ) : (
              <div class="flex gap-4 p-4 border border-neutral-light dark:border-neutral-dark/50 rounded-xl hover:border-primary/30 transition-colors">
                <div class="size-10 rounded-lg bg-[#009D3E]/10 flex items-center justify-center text-[#009D3E] flex-shrink-0">
                  <span class="material-symbols-outlined" style="font-size: 24px;">subway</span>
                </div>
                <div>
                  <p class="font-bold text-text-main dark:text-white">Subway Line 2</p>
                  <p class="text-sm text-text-secondary dark:text-gray-400 mt-0.5">Green Station, Exit 4 (5 min walk)</p>
                </div>
              </div>
            )}
            
            <!-- Bus Item -->
            {location?.bus && location.bus.length > 0 ? (
              <div class="flex gap-4 p-4 border border-neutral-light dark:border-neutral-dark/50 rounded-xl hover:border-primary/30 transition-colors">
                <div class="size-10 rounded-lg bg-[#3D5CFF]/10 flex items-center justify-center text-[#3D5CFF] flex-shrink-0">
                  <span class="material-symbols-outlined" style="font-size: 24px;">directions_bus</span>
                </div>
                <div>
                  <p class="font-bold text-text-main dark:text-white">Blue Bus</p>
                  <div class="flex flex-wrap gap-2 mt-1.5">
                    {location.bus.map((bus, index) => (
                      <span key={index} class="px-2 py-0.5 rounded bg-neutral-light dark:bg-neutral-dark text-xs font-semibold text-text-secondary dark:text-gray-300">
                        {bus.number || bus}
                      </span>
                    ))}
                  </div>
                  {location.bus[0]?.stop && (
                    <p class="text-xs text-text-secondary dark:text-gray-400 mt-1.5">Stop: {location.bus[0].stop}</p>
                  )}
                </div>
              </div>
            ) : (
              <div class="flex gap-4 p-4 border border-neutral-light dark:border-neutral-dark/50 rounded-xl hover:border-primary/30 transition-colors">
                <div class="size-10 rounded-lg bg-[#3D5CFF]/10 flex items-center justify-center text-[#3D5CFF] flex-shrink-0">
                  <span class="material-symbols-outlined" style="font-size: 24px;">directions_bus</span>
                </div>
                <div>
                  <p class="font-bold text-text-main dark:text-white">Blue Bus</p>
                  <div class="flex flex-wrap gap-2 mt-1.5">
                    <span class="px-2 py-0.5 rounded bg-neutral-light dark:bg-neutral-dark text-xs font-semibold text-text-secondary dark:text-gray-300">140</span>
                    <span class="px-2 py-0.5 rounded bg-neutral-light dark:bg-neutral-dark text-xs font-semibold text-text-secondary dark:text-gray-300">402</span>
                    <span class="px-2 py-0.5 rounded bg-neutral-light dark:bg-neutral-dark text-xs font-semibold text-text-secondary dark:text-gray-300">405</span>
                  </div>
                  <p class="text-xs text-text-secondary dark:text-gray-400 mt-1.5">Stop: Han River Middle School</p>
                </div>
              </div>
            )}
          </div>
        </section>

        <!-- Parking Info -->
        <section>
          <h3 class="text-lg font-bold text-text-main dark:text-white mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-text-secondary" style="font-size: 20px;">local_parking</span>
            Parking
          </h3>
          <div class="bg-neutral-light dark:bg-neutral-dark rounded-xl p-5">
            <div class="flex items-start gap-3 mb-4 border-b border-gray-200 dark:border-gray-700/50 pb-4 last:border-0 last:pb-0">
              <div class="mt-1 size-2 rounded-full bg-primary flex-shrink-0"></div>
              <div>
                <p class="font-bold text-sm text-text-main dark:text-white">Main Church Lot (Free)</p>
                <p class="text-sm text-text-secondary dark:text-gray-400 mt-1 leading-relaxed">
                  {location?.parking?.description || 'Available for first-time visitors and families with young children. Approx. 50 spots.'}
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 size-2 rounded-full bg-primary/40 flex-shrink-0"></div>
              <div>
                <p class="font-bold text-sm text-text-main dark:text-white">Overflow Parking</p>
                <p class="text-sm text-text-secondary dark:text-gray-400 mt-1 leading-relaxed">
                  {location?.parking?.overflow || 'Located at the public school across the street. Free on Sundays from 8 AM - 2 PM.'}
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Contact Section -->
        <section class="pt-2">
          <div class="bg-primary/5 dark:bg-primary/10 rounded-2xl p-6 text-center">
            <h3 class="text-lg font-bold text-primary dark:text-primary-content mb-2">Need a ride or help?</h3>
            <p class="text-sm text-text-secondary dark:text-gray-400 mb-6">Our welcome team is ready to assist you with transportation or directions.</p>
            <div class="grid grid-cols-2 gap-3">
              <a 
                class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-background-light dark:bg-neutral-dark border border-primary/20 text-primary dark:text-primary-content font-bold text-sm hover:bg-white dark:hover:bg-neutral-dark/80 transition-colors shadow-sm" 
                href={contact?.phone?.main ? `tel:${contact.phone.main}` : 'tel:+821012345678'}
              >
                <span class="material-symbols-outlined" style="font-size: 20px;">call</span>
                Call Us
              </a>
              <a 
                class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-primary text-primary-content font-bold text-sm hover:bg-primary/90 transition-colors shadow-sm shadow-primary/20" 
                href={contact?.email?.main ? `mailto:${contact.email.main}` : 'mailto:welcome@missionvision.kr'}
              >
                <span class="material-symbols-outlined" style="font-size: 20px;">mail</span>
                Email
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 w-full z-30 bg-background-light dark:bg-background-dark border-t border-neutral-light dark:border-neutral-dark pb-safe">
      <div class="flex justify-around items-end h-16 pb-2 px-2">
        <a class="flex flex-1 flex-col items-center justify-center gap-1 text-text-secondary dark:text-gray-400 group" href="/">
          <span class="material-symbols-outlined group-hover:text-primary transition-colors" style="font-size: 24px;">home</span>
          <span class="text-[10px] font-medium group-hover:text-primary transition-colors">Home</span>
        </a>
        <a class="flex flex-1 flex-col items-center justify-center gap-1 text-text-secondary dark:text-gray-400 group" href="/sermons">
          <span class="material-symbols-outlined group-hover:text-primary transition-colors" style="font-size: 24px;">menu_book</span>
          <span class="text-[10px] font-medium group-hover:text-primary transition-colors">Sermons</span>
        </a>
        <a class="flex flex-1 flex-col items-center justify-center gap-1 text-primary dark:text-primary-content" href="/location">
          <span class="material-symbols-outlined fill-current" style="font-size: 24px; font-variation-settings: 'FILL' 1;">location_on</span>
          <span class="text-[10px] font-medium">Location</span>
        </a>
        <a class="flex flex-1 flex-col items-center justify-center gap-1 text-text-secondary dark:text-gray-400 group" href="/worship">
          <span class="material-symbols-outlined group-hover:text-primary transition-colors" style="font-size: 24px;">calendar_month</span>
          <span class="text-[10px] font-medium group-hover:text-primary transition-colors">Events</span>
        </a>
        <a onclick="window.openMenu?.(); return false;" class="flex flex-1 flex-col items-center justify-center gap-1 text-text-secondary dark:text-gray-400 group cursor-pointer">
          <span class="material-symbols-outlined group-hover:text-primary transition-colors" style="font-size: 24px;">menu</span>
          <span class="text-[10px] font-medium group-hover:text-primary transition-colors">More</span>
        </a>
      </div>
    </nav>

    <!-- Safe area padding for bottom nav -->
    <style>
      .pb-safe {
        padding-bottom: env(safe-area-inset-bottom);
      }
    </style>
    
    <MenuDrawer />
  </div>
</Layout>
