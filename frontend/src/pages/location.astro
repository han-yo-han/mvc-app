---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import { getLocation, getContact, getChurch } from '../lib/content.js';

const location = getLocation();
const contact = getContact();
const church = getChurch();
---

<Layout title="오시는길 - 선교비전교회">
  <div class="flex flex-col min-h-screen bg-white text-text-main antialiased">
    <PageHeader currentPath="/location" />

    <main class="flex-1 w-full pb-24 lg:pb-12">
      <!-- Map Section -->
      <section class="relative w-full h-[35vh] min-h-[250px] bg-gray-200">
        <div class="absolute inset-0 w-full h-full bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD56pzvI80_uUC_Himmxt1IDeKPPcX7jn6o0ODWzMi1MDFxvz6VZaTtid2DG77jeAKXG6L4BMHeSRP1IGZd2L2Ugefk3vw2BeOdDO6_vImagTwhGHdlOok338PzeTvQs_adSpVSobXWoEoilourthLhJ3EcoQoSO5W9hoBM1l2a8lFF_-Xcq7_5WTpqQTvHyu_u_tUpaVnPrz7jz1G27qR5GSGT2ITVHv2_hcY1fm3b0_A05wUSNQDhIlFyhRg0xh1mzOH2wES-QcsL');">
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>
        <div class="absolute bottom-6 right-6 z-10">
          <button
            onclick={location?.coordinates ? `window.open('https://www.google.com/maps/dir/?api=1&destination=${location.coordinates.lat},${location.coordinates.lng}', '_blank')` : undefined}
            class="flex items-center justify-center size-14 rounded-full bg-primary text-white shadow-lg shadow-primary/30 hover:scale-105 active:scale-95 transition-all"
          >
            <span class="material-symbols-outlined" style="font-size: 28px;">directions</span>
          </button>
        </div>
      </section>

      <!-- Content Container -->
      <div class="max-w-5xl mx-auto px-4 lg:px-8 py-6 space-y-8 -mt-4 bg-white rounded-t-3xl relative z-10 shadow-[0_-4px_20px_rgba(0,0,0,0.05)]">
        <!-- Address Card -->
        <section>
          <div class="flex items-start justify-between mb-2">
            <div>
              <h2 class="text-2xl font-bold text-[#0d121b] tracking-tight">{church?.name || '선교비전교회'}</h2>
              <p class="text-sm text-text-muted mt-1">본당</p>
            </div>
          </div>
          <div class="mt-4 p-4 rounded-xl bg-white flex items-center justify-between gap-3 shadow-soft">
            <div class="flex items-start gap-3 flex-1">
              <span class="material-symbols-outlined text-primary mt-0.5" style="font-size: 22px;">location_on</span>
              <div class="text-sm font-medium text-[#0d121b] leading-relaxed">
                {location?.address?.full || '주소 정보 준비 중'}
                {location?.address?.detail && (
                  <><br/>{location.address.detail}</>
                )}
              </div>
            </div>
            <button
              aria-label="주소 복사"
              class="p-2 text-primary hover:bg-primary/10 rounded-lg transition-colors flex-shrink-0"
              onclick={`navigator.clipboard.writeText('${location?.address?.full || ''} ${location?.address?.detail || ''}')`}
            >
              <span class="material-symbols-outlined" style="font-size: 20px;">content_copy</span>
            </button>
          </div>
        </section>

        <!-- Public Transport -->
        <section>
          <h3 class="text-lg font-bold text-[#0d121b] mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-text-muted" style="font-size: 20px;">commute</span>
            대중교통
          </h3>
          <div class="space-y-3">
            {location?.subway && location.subway.length > 0 ? (
              location.subway.map((subway, index) => (
                <div class="flex gap-4 p-4 bg-white rounded-xl shadow-soft">
                  <div class="size-10 rounded-lg bg-[#009D3E]/10 flex items-center justify-center text-[#009D3E] flex-shrink-0">
                    <span class="material-symbols-outlined" style="font-size: 24px;">subway</span>
                  </div>
                  <div>
                    <p class="font-bold text-[#0d121b]">지하철 {subway.line || '2'}호선</p>
                    <p class="text-sm text-text-muted mt-0.5">
                      {subway.station || '역이름'}, {subway.exit || '출구'} ({subway.walkingTime || '도보 5분'})
                    </p>
                  </div>
                </div>
              ))
            ) : (
              <div class="flex gap-4 p-4 bg-white rounded-xl shadow-soft">
                <div class="size-10 rounded-lg bg-[#009D3E]/10 flex items-center justify-center text-[#009D3E] flex-shrink-0">
                  <span class="material-symbols-outlined" style="font-size: 24px;">subway</span>
                </div>
                <div>
                  <p class="font-bold text-[#0d121b]">지하철 2호선</p>
                  <p class="text-sm text-text-muted mt-0.5">Green Station, Exit 4 (도보 5분)</p>
                </div>
              </div>
            )}

            {location?.bus && location.bus.length > 0 ? (
              <div class="flex gap-4 p-4 bg-white rounded-xl shadow-soft">
                <div class="size-10 rounded-lg bg-[#3D5CFF]/10 flex items-center justify-center text-[#3D5CFF] flex-shrink-0">
                  <span class="material-symbols-outlined" style="font-size: 24px;">directions_bus</span>
                </div>
                <div>
                  <p class="font-bold text-[#0d121b]">버스</p>
                  <div class="flex flex-wrap gap-2 mt-1.5">
                    {location.bus.map((bus, index) => (
                      <span class="px-2 py-0.5 rounded bg-gray-100 text-xs font-semibold text-gray-600">
                        {bus.number || bus}
                      </span>
                    ))}
                  </div>
                  {location.bus[0]?.stop && (
                    <p class="text-xs text-text-muted mt-1.5">정류장: {location.bus[0].stop}</p>
                  )}
                </div>
              </div>
            ) : (
              <div class="flex gap-4 p-4 bg-white rounded-xl shadow-soft">
                <div class="size-10 rounded-lg bg-[#3D5CFF]/10 flex items-center justify-center text-[#3D5CFF] flex-shrink-0">
                  <span class="material-symbols-outlined" style="font-size: 24px;">directions_bus</span>
                </div>
                <div>
                  <p class="font-bold text-[#0d121b]">버스</p>
                  <div class="flex flex-wrap gap-2 mt-1.5">
                    <span class="px-2 py-0.5 rounded bg-gray-100 text-xs font-semibold text-gray-600">140</span>
                    <span class="px-2 py-0.5 rounded bg-gray-100 text-xs font-semibold text-gray-600">402</span>
                    <span class="px-2 py-0.5 rounded bg-gray-100 text-xs font-semibold text-gray-600">405</span>
                  </div>
                  <p class="text-xs text-text-muted mt-1.5">정류장: 한강중학교</p>
                </div>
              </div>
            )}
          </div>
        </section>

        <!-- Parking Info -->
        <section>
          <h3 class="text-lg font-bold text-[#0d121b] mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-text-muted" style="font-size: 20px;">local_parking</span>
            주차 안내
          </h3>
          <div class="bg-white rounded-xl p-5 shadow-soft space-y-4">
            <div class="flex items-start gap-3">
              <div class="mt-1 size-2 rounded-full bg-primary flex-shrink-0"></div>
              <div>
                <p class="font-bold text-sm text-[#0d121b]">교회 주차장 (무료)</p>
                <p class="text-sm text-text-muted mt-1 leading-relaxed">
                  {location?.parking?.description || '처음 방문하시는 분과 어린 자녀가 있는 가정 우선. 약 50대 주차 가능.'}
                </p>
              </div>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex items-start gap-3">
              <div class="mt-1 size-2 rounded-full bg-primary/40 flex-shrink-0"></div>
              <div>
                <p class="font-bold text-sm text-[#0d121b]">추가 주차</p>
                <p class="text-sm text-text-muted mt-1 leading-relaxed">
                  {location?.parking?.overflow || '건너편 학교 주차장. 주일 오전 8시 - 오후 2시 무료 이용 가능.'}
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Contact Section -->
        <section>
          <div class="bg-primary/5 rounded-2xl p-6 text-center">
            <h3 class="text-lg font-bold text-primary mb-2">도움이 필요하신가요?</h3>
            <p class="text-sm text-text-muted mb-6">교통편이나 길 안내가 필요하시면 연락주세요.</p>
            <div class="grid grid-cols-2 gap-3">
              <a
                class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white border border-primary/20 text-primary font-bold text-sm hover:bg-gray-50 transition-colors shadow-sm"
                href={contact?.phone?.main ? `tel:${contact.phone.main}` : '#'}
              >
                <span class="material-symbols-outlined" style="font-size: 20px;">call</span>
                전화하기
              </a>
              <a
                class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-primary text-white font-bold text-sm hover:bg-primary/90 transition-colors shadow-sm shadow-primary/20"
                href={contact?.email?.main ? `mailto:${contact.email.main}` : '#'}
              >
                <span class="material-symbols-outlined" style="font-size: 20px;">mail</span>
                이메일
              </a>
            </div>
          </div>
        </section>
      </div>
    </main>

    <BottomNav currentPath="/location" />
    <MenuDrawer />
  </div>
</Layout>
