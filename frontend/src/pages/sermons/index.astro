---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import BottomNav from '../../components/BottomNav.astro';
import MenuDrawer from '../../components/MenuDrawer.astro';
import { getAllSermons, getChurch, getContact, getLocation, getWorship } from '../../lib/content.js';
import SermonCard from '../../components/SermonCard.astro';

const sermons = getAllSermons();
const church = getChurch();
const contact = getContact();
const location = getLocation();
const worship = getWorship();
---

<Layout title="설교 - 선교비전교회">
  <script>
    alert('준비중입니다.');
    window.location.href = '/';
  </script>
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-cream to-sand text-charcoal antialiased">
    <PageHeader currentPath="/sermons" />

    <div class="sticky top-0 z-40 bg-cream/95 backdrop-blur-xl border-b border-border/80">
      <div class="max-w-page mx-auto px-4 lg:px-8 py-4 flex flex-col gap-4">
        <div class="relative w-full">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-muted">
            <span class="material-symbols-outlined text-xl">search</span>
          </div>
          <input class="block w-full pl-12 pr-4 py-3 border border-border/60 rounded-xl bg-surface text-charcoal text-sm focus:ring-2 focus:ring-accent/20 focus:border-accent/40 placeholder:text-muted transition-all" placeholder="설교, 성경 구절, 주제 검색" type="text"/>
        </div>
        <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1 -mx-4 px-4">
          <button class="whitespace-nowrap px-5 py-2.5 rounded-full bg-charcoal text-cream text-sm font-medium">
            전체
          </button>
          <button class="whitespace-nowrap px-5 py-2.5 rounded-full bg-surface text-charcoal text-sm font-medium border border-border/60 hover:border-accent/30 transition-colors">
            2024
          </button>
          <button class="whitespace-nowrap px-5 py-2.5 rounded-full bg-surface text-charcoal text-sm font-medium border border-border/60 hover:border-accent/30 transition-colors">
            2023
          </button>
          <button class="whitespace-nowrap px-5 py-2.5 rounded-full bg-surface text-charcoal text-sm font-medium border border-border/60 hover:border-accent/30 transition-colors">
            시리즈
          </button>
        </div>
      </div>
    </div>

    <main class="flex-1 w-full max-w-page mx-auto px-4 lg:px-8 pt-6 lg:pt-8 pb-24 lg:pb-12">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <h1 class="font-display text-4xl font-semibold text-charcoal">최근 설교</h1>
        <span class="text-sm text-muted font-medium">{sermons?.length || 0}개</span>
      </div>

      <div class="flex flex-col gap-8 scroll-reveal">
        {sermons && sermons.length > 0 ? (
          <>
            {sermons.map((sermon) => (
              <SermonCard sermon={sermon} />
            ))}
            <button class="w-full py-4 rounded-xl border-2 border-border/60 text-sm font-bold text-muted hover:bg-surface hover:border-accent/20 transition-all">
              더 보기
            </button>
          </>
        ) : (
          <div class="text-center py-24">
            <span class="material-symbols-outlined text-8xl text-muted-light/50 mb-6">video_library</span>
            <p class="text-muted text-lg">아직 등록된 설교가 없습니다.</p>
          </div>
        )}
      </div>
    </main>

    <Footer church={church} contact={contact} location={location} worship={worship} />
    <BottomNav currentPath="/sermons" />
    <MenuDrawer />
  </div>
</Layout>
