---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import { getChurch, getWorship, getAllSermons, getContact, getLocation } from '../lib/content.js';

const church = getChurch();
const worship = getWorship();
const sermons = getAllSermons();
const contact = getContact();
const location = getLocation();
---

<Layout title={church?.name || '선교비전교회'}>
  <div class="flex flex-col min-h-screen bg-white font-display text-[#0d121b] antialiased selection:bg-primary/20">
    <PageHeader />

    <main class="flex-1 flex flex-col w-full overflow-x-hidden pb-20">
      <!-- Cinematic Hero Section -->
      <section class="relative w-full h-[75vh] min-h-[420px] flex items-center justify-center">
        <div class="absolute inset-0 z-0">
          <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/60 z-10"></div>
          <div class="w-full h-full bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuACTFWvcSCumToGQ4Kg1CJEqUOr2lDDwQgRI2Lk2ltk57-J8LYLOgftMKsNAlWuYVhypvM-BF7TZbh8xEkGGYbqxOMb46IfvnFFu5Uo32YJN_yP3NjjtFAVqojK5fgjpMqpa-1Eb0g8TYOgfs-qOPnew33jxQWDI-xrwxN5o4SVd5ZOwe_8o0RLVafRFqNFsHa3yMVUJyttL_FcAHM1L3sUlHPOoltKlIIhBcEBZ0PLFEXKYeUQpd8Har5dXJG5TfJ7AVU6W2g5SQlG');"></div>
        </div>
        <div class="relative z-20 flex flex-col items-center text-center px-6 max-w-lg mx-auto gap-4">
          <h1 class="font-serif text-5xl sm:text-6xl text-white font-medium tracking-tight drop-shadow-md leading-tight">
            {church?.name || '선교비전교회'}
          </h1>
          <div class="h-1 w-16 bg-white/80 rounded-full my-2"></div>
          <p class="text-white/90 text-lg sm:text-xl font-medium tracking-wide drop-shadow-sm max-w-[280px]">
            {church?.slogan || '하나님의 사랑을 세상에 전하는 교회'}
          </p>
          <a
            href={worship?.onlineLink || '/worship'}
            target={worship?.onlineLink ? '_blank' : undefined}
            rel={worship?.onlineLink ? 'noopener noreferrer' : undefined}
            class="mt-4 bg-white text-primary hover:bg-gray-100 active:bg-gray-200 transition-colors px-8 py-3.5 rounded-full font-bold text-sm uppercase tracking-wider shadow-lg"
          >
            온라인 예배
          </a>
        </div>
      </section>

      <!-- Core Values Section -->
      <section class="py-16 px-4 bg-white">
        <div class="text-center mb-10 max-w-xl mx-auto">
          <span class="text-primary text-xs font-bold uppercase tracking-[0.2em] mb-2 block">Our DNA</span>
          <h2 class="text-3xl font-serif text-[#0d121b]">핵심 가치</h2>
        </div>
        <div class="flex flex-col gap-6 max-w-xl mx-auto">
          {church?.coreValues && church.coreValues.length > 0 ? (
            church.coreValues.map((value, index) => {
              const icons = ['menu_book', 'volunteer_activism', 'favorite'];
              const icon = icons[index] || 'favorite';
              return (
                <div class="group flex items-start gap-5 p-6 rounded-2xl bg-[#f8f9fc] border border-primary/5 shadow-sm hover:shadow-md transition-all duration-300">
                  <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                    <span class="material-symbols-outlined">{icon}</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <h3 class="text-lg font-bold text-[#0d121b]">{value.title}</h3>
                    <p class="text-text-muted text-sm leading-relaxed">{value.description}</p>
                  </div>
                </div>
              );
            })
          ) : (
            <>
              <div class="group flex items-start gap-5 p-6 rounded-2xl bg-[#f8f9fc] border border-primary/5 shadow-sm hover:shadow-md transition-all duration-300">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                  <span class="material-symbols-outlined">menu_book</span>
                </div>
                <div class="flex flex-col gap-1">
                  <h3 class="text-lg font-bold text-[#0d121b]">말씀</h3>
                  <p class="text-text-muted text-sm leading-relaxed">성경 말씀에 깊이 뿌리내린 교회</p>
                </div>
              </div>
              <div class="group flex items-start gap-5 p-6 rounded-2xl bg-[#f8f9fc] border border-primary/5 shadow-sm hover:shadow-md transition-all duration-300">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                  <span class="material-symbols-outlined">volunteer_activism</span>
                </div>
                <div class="flex flex-col gap-1">
                  <h3 class="text-lg font-bold text-[#0d121b]">선교</h3>
                  <p class="text-text-muted text-sm leading-relaxed">이웃을 섬기며 도움의 손길을 내미는 공동체</p>
                </div>
              </div>
              <div class="group flex items-start gap-5 p-6 rounded-2xl bg-[#f8f9fc] border border-primary/5 shadow-sm hover:shadow-md transition-all duration-300">
                <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-300">
                  <span class="material-symbols-outlined">favorite</span>
                </div>
                <div class="flex flex-col gap-1">
                  <h3 class="text-lg font-bold text-[#0d121b]">사랑</h3>
                  <p class="text-text-muted text-sm leading-relaxed">열린 마음으로 모두를 환영하는 가족</p>
                </div>
              </div>
            </>
          )}
        </div>
      </section>

      <!-- Worship Schedule CTA -->
      <section class="px-4 pb-16">
        <div class="bg-primary rounded-3xl overflow-hidden shadow-xl max-w-xl mx-auto relative isolate">
          <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-white/5 blur-3xl z-[-1]"></div>
          <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 rounded-full bg-black/10 blur-2xl z-[-1]"></div>
          <div class="p-8 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div class="flex flex-col gap-4">
              <div class="space-y-1">
                <h2 class="text-white text-2xl font-bold font-serif">이번 주일, 함께해요</h2>
                <p class="text-blue-100 text-sm font-medium opacity-90">매주 함께 예배드려요</p>
              </div>
              <div class="space-y-3 pt-2">
                {worship?.schedules && worship.schedules.length > 0 ? (
                  worship.schedules.map((schedule, i) => (
                    <div class="flex items-center gap-3 justify-center sm:justify-start">
                      <span class="material-symbols-outlined text-white/80 text-[20px]">{i === 0 ? 'schedule' : 'coffee'}</span>
                      <span class="text-white text-base font-semibold">{schedule.time || '오전 10시'} — {schedule.type || '예배'}</span>
                    </div>
                  ))
                ) : (
                  <>
                    <div class="flex items-center gap-3 justify-center sm:justify-start">
                      <span class="material-symbols-outlined text-white/80 text-[20px]">schedule</span>
                      <span class="text-white text-base font-semibold">오전 10시 — 주일예배</span>
                    </div>
                    <div class="flex items-center gap-3 justify-center sm:justify-start">
                      <span class="material-symbols-outlined text-white/80 text-[20px]">coffee</span>
                      <span class="text-white text-base font-semibold">오전 11시 30분 — 친교</span>
                    </div>
                  </>
                )}
              </div>
            </div>
            <a
              href="/newcomer"
              class="bg-white text-primary hover:bg-gray-50 active:bg-gray-100 w-full sm:w-auto px-6 py-3 rounded-xl font-bold text-sm shadow-md transition-all transform active:scale-95 flex items-center justify-center gap-2"
            >
              <span>방문 안내</span>
              <span class="material-symbols-outlined text-sm font-bold">arrow_forward</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Scripture Banner -->
      <div class="w-full px-4 pb-16">
        <div class="w-full h-48 sm:h-64 rounded-2xl bg-cover bg-center shadow-inner relative overflow-hidden max-w-xl mx-auto" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBSfar1nEXbuqsxzp4IG1RRKi-BWQe_zr_B5yJ0MDuoRZ0TaSUBYU8b_Hm2cyJsmtSJzPuPqzpTBkhLlMzmncJ8cX-20n0MIHEs2izFxiiI43DoVuLejTGHybb4UwyNzDw3023K5vJim7j9v6RhliLK2MansYWge2dcH5fuNmTi4vtjDwvI489HoUt8Y4WAZ3S_fAqHqt7yp2s0Cd_1d34AJq77nHnF1hcGccJeZe3l5I1mnGKJiZnCZrRqFS-U5hZt2gqFFk86mzax');">
          <div class="absolute inset-0 bg-primary/20 mix-blend-multiply"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <p class="text-white font-serif text-xl sm:text-2xl italic px-6 text-center drop-shadow-md leading-relaxed">
              "너희가 서로 사랑하면 이로써 모든 사람이<br class="hidden sm:block" /> 너희가 내 제자인 줄 알리라"
            </p>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-[#101622] text-white py-12 px-6 pb-24">
      <div class="max-w-xl mx-auto flex flex-col gap-8">
        <div class="flex flex-col gap-4 text-center">
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="material-symbols-outlined text-white/80" style="font-variation-settings: 'FILL' 1;">church</span>
            <span class="font-serif text-2xl tracking-wide">{church?.name || '선교비전교회'}</span>
          </div>
          <p class="text-gray-400 text-sm leading-relaxed max-w-xs mx-auto">
            {church?.intro || '소망, 은혜, 사랑의 메시지로 삶을 변화시키는 교회. 있는 그대로 오세요.'}
          </p>
        </div>
        <div class="h-px w-full bg-white/10"></div>
        <div class="flex flex-col gap-4 text-center">
          {location?.address && (
            <div class="flex flex-col gap-1">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">오시는 길</span>
              <p class="text-white">{location.address.full}</p>
              {location.address.detail && (
                <p class="text-white">{location.address.detail}</p>
              )}
            </div>
          )}
          {contact && (
            <div class="flex flex-col gap-1 mt-2">
              <span class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">연락처</span>
              {contact.email && (
                <a class="text-primary hover:text-white transition-colors" href={`mailto:${contact.email.main}`}>
                  {contact.email.display || contact.email.main}
                </a>
              )}
              {contact.phone && (
                <a class="text-white hover:text-primary transition-colors" href={`tel:${contact.phone.main}`}>
                  {contact.phone.display || contact.phone.main}
                </a>
              )}
            </div>
          )}
        </div>
        <div class="text-center text-xs text-gray-600 mt-4">
          © {new Date().getFullYear()} {church?.name || '선교비전교회'}. All rights reserved.
        </div>
      </div>
    </footer>

    <BottomNav currentPath="/" />
    <MenuDrawer />
  </div>
</Layout>
