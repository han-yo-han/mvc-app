---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import MapViewer from '../components/MapViewer.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import { getChurch, getWorship, getContact, getLocation, getHeroSlides } from '../lib/content.js';

const church = getChurch();
const worship = getWorship();
const contact = getContact();
const location = getLocation();
const heroSlides = getHeroSlides();
---

<Layout title="선교비전교회 - 일어나 빛을 발하라">
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-cream to-sand text-charcoal antialiased">
    <PageHeader currentPath="/" />

    <main class="flex-1 pb-20 lg:pb-0">

      <!-- HERO: 일몰/산 풍경 배경 -->
      <section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center overflow-hidden">
        <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/hero-bg.png');"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-charcoal/70 via-charcoal/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-charcoal/50 pointer-events-none"></div>

        <div class="relative z-20 max-w-page mx-auto px-4 lg:px-8 py-20 lg:py-28 w-full">
          <div class="max-w-2xl">
            <span class="reveal block mb-6 text-sm font-semibold uppercase tracking-[0.2em] text-amber/95">
              {church?.yearTheme || '성령께서 주인 되시는 교회'}
            </span>
            <h1 class="reveal reveal-delay-1 font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.1] mb-6 drop-shadow-lg">
              {church?.name || '선교비전교회'}
            </h1>
            <p class="reveal reveal-delay-2 font-display text-2xl lg:text-3xl text-amber font-semibold mb-6 drop-shadow-md">
              {church?.slogan || '일어나 빛을 발하라'}
            </p>
            <blockquote class="reveal reveal-delay-3 text-white/95 text-base lg:text-lg max-w-xl leading-relaxed mb-10 drop-shadow">
              "{church?.scripture?.text || '일어나라 빛을 발하라 이는 네 빛이 이르렀고 여호와의 영광이 네 위에 임하였음이니라'}"
              <cite class="block mt-3 text-sm text-white/80 font-medium">— {church?.scripture?.reference || '이사야 60:1'}</cite>
            </blockquote>
            <div class="reveal reveal-delay-4 flex flex-col sm:flex-row gap-4">
              <a href="/worship" class="inline-flex items-center justify-center bg-white/95 hover:bg-white text-charcoal px-8 py-4 rounded-lg font-bold transition-all shadow-elevated border border-white/50">
                예배 안내
              </a>
              <a href="/location" class="inline-flex items-center justify-center bg-white/20 hover:bg-white/40 backdrop-blur-sm text-white border-2 border-white/50 px-8 py-4 rounded-lg font-bold transition-all">
                오시는 길
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 사역/예배 현장: 슬라이드 -->
      {heroSlides && heroSlides.length > 0 && (
        <section class="relative py-16 lg:py-20 overflow-hidden bg-cream">
          <div class="relative max-w-page mx-auto px-4 lg:px-8 mb-10">
            <span class="section-label block mb-4">사역 소개</span>
            <h2 class="font-display text-3xl lg:text-4xl font-semibold text-charcoal tracking-tight mb-6">사역/예배 현장</h2>
            <hr class="h-px border-0 bg-forest/25 max-w-3xl" aria-hidden="true" />
          </div>
          <div class="relative w-full">
            <PhotoStrip images={heroSlides} />
          </div>
        </section>
      )}

      <!-- IDENTITY -->
      <section class="relative py-24 lg:py-32 overflow-hidden bg-cream-dark">
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[50%] max-w-[600px] h-[120%] opacity-15">
          <div class="absolute inset-0 bg-cover bg-center scale-110 blur-2xl" style="background-image: url('/images/pastor.png');"></div>
        </div>
        <div class="relative max-w-page mx-auto px-4 lg:px-8 scroll-reveal">
          <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            <div class="lg:col-span-5 lg:sticky lg:top-28">
              <span class="section-label block mb-4">선교비전교회는</span>
                <h2 class="font-display text-4xl lg:text-5xl font-semibold text-charcoal tracking-tight mb-6">
                  {church?.vision ? '선교적인 꿈' : '우리의 정체성'}
              </h2>
              {church?.vision && (
                <p class="text-ink/90 text-lg leading-relaxed">
                  {church.vision}
                </p>
              )}
            </div>
            <div class="lg:col-span-7">
              <div class="grid sm:grid-cols-2 gap-6">
                {(church?.coreValues || []).map((value, index) => {
                  const icons = ['group', 'local_fire_department', 'public', 'menu_book'];
                  return (
                    <div class="group bg-white rounded-2xl p-8 border border-border hover:border-forest/30 shadow-soft hover:shadow-card transition-all duration-300">
                      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6 bg-forest/10 text-forest group-hover:scale-105 transition-transform">
                        <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">{icons[index] || 'favorite'}</span>
                      </div>
                      <h3 class="font-display text-xl font-semibold text-charcoal mb-2">{value.title}</h3>
                      <p class="text-muted text-sm leading-relaxed">{value.description}</p>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- WORSHIP -->
      <section class="relative py-24 lg:py-32 overflow-hidden bg-cream">
        <div class="relative max-w-page mx-auto px-4 lg:px-8 scroll-reveal">
          <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-16">
            <div>
              <span class="section-label block mb-4">예배 안내</span>
              <h2 class="font-display text-4xl lg:text-5xl font-semibold text-charcoal tracking-tight">함께 예배해요</h2>
            </div>
            <a href="/worship" class="text-forest font-semibold hover:text-forest/80 transition-colors flex items-center gap-2">
              전체 예배 안내 <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">arrow_forward</span>
            </a>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {worship?.schedules && worship.schedules.slice(0, 6).map((schedule) => (
              <div class="bg-white rounded-2xl p-8 border border-border hover:border-forest/30 shadow-soft hover:shadow-card transition-all duration-300">
                <div class="flex items-center gap-4 mb-4">
                  <div class="w-16 h-16 rounded-2xl bg-forest/10 text-forest flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">event</span>
                  </div>
                  <h3 class="font-display text-xl font-semibold text-charcoal">{schedule.type}</h3>
                </div>
                <div class="space-y-2 ml-16">
                  <p class="text-charcoal font-semibold">{schedule.time}</p>
                  <p class="text-muted text-sm">{schedule.location}</p>
                  {schedule.description && <p class="text-ink/80 text-sm">{schedule.description}</p>}
                </div>
              </div>
            ))}
          </div>

          {worship?.training && worship.training.length > 0 && (
            <div class="mt-12 grid sm:grid-cols-2 gap-6">
              {worship.training.map((item) => (
                <div class="bg-white rounded-2xl p-6 border border-border flex items-center gap-4 shadow-soft">
                  <div class="w-16 h-16 rounded-2xl bg-forest/10 text-forest flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">school</span>
                  </div>
                  <div>
                    <h3 class="font-display text-lg font-semibold text-charcoal">{item.name}</h3>
                    <p class="text-muted font-medium text-sm">{item.time}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>

      <!-- ONLINE WORSHIP: CTA -->
      {(worship?.onlineLink || worship?.youtubeChannel) && (
        <section class="relative py-24 lg:py-32 overflow-hidden bg-cream">
          <div class="relative max-w-page mx-auto px-4 lg:px-8">
            <div class="relative rounded-2xl overflow-hidden bg-white border border-border shadow-soft p-12 lg:p-20">
              <div class="max-w-2xl">
                <span class="section-label block mb-4">온라인 예배</span>
                <h2 class="font-display text-4xl lg:text-5xl font-semibold text-charcoal mb-4">언제 어디서든 함께해요</h2>
                <p class="text-muted text-lg mb-8">YouTube 채널에서 주일 예배를 실시간으로 시청하실 수 있습니다.</p>
                <div class="flex flex-col sm:flex-row gap-4">
                  {worship.onlineLink && (
                    <a href={worship.onlineLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-forest/90 hover:bg-forest text-cream px-8 py-4 rounded-lg font-bold transition-all">
                      예배 실황(Live 시청)
                    </a>
                  )}
                  {worship.youtubeChannel && (
                    <a href={worship.youtubeChannel} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center border-2 border-forest/40 hover:bg-forest/5 text-forest px-8 py-4 rounded-lg font-bold transition-all">
                      YouTube 채널
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- MISSIONS -->
      {(church?.missionWork || church?.evangelism) && (
        <section class="relative py-24 lg:py-32 overflow-hidden bg-cream">
          <div class="relative max-w-page mx-auto px-4 lg:px-8 scroll-reveal">
            <span class="section-label block mb-4">선교 & 전도</span>
            <h2 class="font-display text-4xl lg:text-5xl font-semibold text-charcoal tracking-tight mb-16">열방을 향해</h2>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {church?.missionWork?.map((mission) => (
                <div class="bg-white rounded-2xl p-8 border border-border shadow-soft">
                  <div class="w-16 h-16 rounded-2xl bg-forest/10 text-forest flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">public</span>
                  </div>
                  <h3 class="font-display text-xl font-semibold text-charcoal">{mission.country}</h3>
                  <p class="text-muted">{mission.missionary}</p>
                </div>
              ))}
              {church?.evangelism?.streetEvangelism && (
                <div class="bg-white rounded-2xl p-8 border border-border shadow-soft">
                  <div class="w-16 h-16 rounded-2xl bg-forest/10 text-forest flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">directions_walk</span>
                  </div>
                  <h3 class="font-display text-xl font-semibold text-charcoal">노방전도</h3>
                  <p class="text-muted">{church.evangelism.streetEvangelism}</p>
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      <!-- LOCATION -->
      <section class="relative py-24 lg:py-32 overflow-hidden bg-cream-dark">
        <div class="relative max-w-page mx-auto px-4 lg:px-8 scroll-reveal">
          <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
            <div class="lg:col-span-3 relative">
              {location?.coordinates ? (
                <>
                  <MapViewer
                    lat={location.coordinates.lat}
                    lng={location.coordinates.lng}
                    title={church?.name || '선교비전교회'}
                    height="320px"
                    zoom={16}
                    address={location?.address?.full}
                  />
                  <a
                    href={`https://map.naver.com/p/search/${encodeURIComponent(location?.address?.full || '서울 동대문구 사가정로 190')}`}
                    target="_blank" rel="noopener noreferrer"
                    class="absolute bottom-4 right-4 z-[1000] bg-forest text-cream px-5 py-2.5 rounded-lg font-semibold flex items-center gap-2 shadow-elevated hover:bg-forest-light transition-colors"
                  >
                    <span class="material-symbols-outlined text-xl">directions</span>
                    길찾기
                  </a>
                </>
              ) : (
                <div class="rounded-2xl min-h-[320px] bg-muted/20 flex items-center justify-center">
                  <p class="text-muted">위치 정보를 불러올 수 없습니다.</p>
                </div>
              )}
            </div>
            <div class="lg:col-span-2 space-y-6">
              <div>
                <span class="section-label block mb-4">오시는 길</span>
                <h2 class="font-display text-3xl font-semibold text-charcoal mb-6">교회 위치</h2>
              </div>
              <div class="bg-white rounded-2xl p-6 border border-border shadow-soft">
                <h3 class="font-semibold text-charcoal mb-3 flex items-center gap-2">
                  <span class="material-symbols-outlined text-2xl text-forest" style="font-variation-settings: 'FILL' 1;">location_on</span>
                  주소
                </h3>
                <p class="text-ink leading-relaxed">
                  {location?.address?.full || '서울 동대문구 사가정로 190'}<br/>{location?.address?.detail || '우성종합상가 4층(401호)'}
                </p>
              </div>
              <div class="bg-white rounded-2xl p-6 border border-border shadow-soft">
                <h3 class="font-semibold text-charcoal mb-3 flex items-center gap-2">
                  <span class="material-symbols-outlined text-2xl text-forest" style="font-variation-settings: 'FILL' 1;">commute</span>
                  대중교통
                </h3>
                <div class="space-y-2 text-sm text-ink">
                  {location?.subway?.map((s) => (
                    <p><span class="font-semibold text-charcoal">지하철 {s.line}호선</span> · {s.station} ({s.walkingTime})</p>
                  ))}
                  {location?.bus && (
                    <div class="flex flex-wrap items-center gap-2 mt-2">
                      <span class="font-semibold text-charcoal">버스</span>
                      {location.bus.map((b) => (
                        <span class="px-2 py-0.5 bg-cream rounded text-xs font-medium">{b.number || b}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              <a href="/location" class="inline-flex items-center gap-2 text-forest font-semibold hover:text-forest/80 transition-colors">
                자세히 보기 <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- OFFERING -->
      {contact?.offering && (
        <section class="relative py-24 lg:py-32 overflow-hidden bg-cream">
          <div class="relative max-w-page mx-auto px-4 lg:px-8 scroll-reveal">
            <span class="section-label block mb-4">헌금 안내</span>
            <h2 class="font-display text-4xl font-semibold text-charcoal mb-6">감사의 마음으로</h2>
            <hr class="h-px border-0 bg-forest/25 mb-10 max-w-3xl" aria-hidden="true" />

            <div class="max-w-4xl border border-forest/20 rounded-2xl overflow-hidden bg-white/90 shadow-soft">
              <div class="grid sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-forest/20">
                <!-- 일반헌금 -->
                <div class="p-10 lg:p-12">
                  <h3 class="text-sm font-semibold text-muted uppercase tracking-wider mb-6 pb-3 border-b border-border/80">일반헌금</h3>
                  <dl class="space-y-5">
                    <div>
                      <dt class="text-sm text-muted mb-1.5">은행</dt>
                      <dd class="font-display text-xl font-semibold text-charcoal">{contact.offering.general.bank}</dd>
                    </div>
                    <hr class="h-px border-0 bg-border/60" aria-hidden="true" />
                    <div>
                      <dt class="text-sm text-muted mb-1.5">계좌번호</dt>
                      <dd class="text-forest font-mono font-semibold text-xl">{contact.offering.general.account}</dd>
                    </div>
                    <hr class="h-px border-0 bg-border/60" aria-hidden="true" />
                    <div>
                      <dt class="text-sm text-muted mb-1.5">용도</dt>
                      <dd class="text-base text-ink">{contact.offering.general.purpose}</dd>
                    </div>
                  </dl>
                </div>

                <!-- 특별헌금 -->
                <div class="p-10 lg:p-12">
                  <h3 class="text-sm font-semibold text-muted uppercase tracking-wider mb-6 pb-3 border-b border-border/80">특별헌금</h3>
                  <dl class="space-y-5">
                    <div>
                      <dt class="text-sm text-muted mb-1.5">은행</dt>
                      <dd class="font-display text-xl font-semibold text-charcoal">{contact.offering.special.bank}</dd>
                    </div>
                    <hr class="h-px border-0 bg-border/60" aria-hidden="true" />
                    <div>
                      <dt class="text-sm text-muted mb-1.5">계좌번호</dt>
                      <dd class="text-forest font-mono font-semibold text-xl">{contact.offering.special.account}</dd>
                    </div>
                    <hr class="h-px border-0 bg-border/60" aria-hidden="true" />
                    <div>
                      <dt class="text-sm text-muted mb-1.5">용도</dt>
                      <dd class="text-base text-ink">{contact.offering.special.purpose}</dd>
                    </div>
                  </dl>
                </div>
              </div>
              <div class="px-10 lg:px-12 py-5 border-t border-forest/20 bg-forest/5">
                <p class="text-center text-base font-medium text-charcoal">예금주: {contact.offering.general.holder}</p>
              </div>
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer church={church} contact={contact} location={location} worship={worship} />
    <BottomNav currentPath="/" />
    <MenuDrawer />
  </div>
</Layout>
