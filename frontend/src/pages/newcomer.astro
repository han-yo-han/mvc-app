---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import MenuDrawer from '../components/MenuDrawer.astro';
import { getNewcomer, getContact, getChurch, getLocation, getWorship } from '../lib/content.js';

const newcomer = getNewcomer();
const contact = getContact();
const church = getChurch();
const location = getLocation();
const worship = getWorship();
---

<Layout title="새가족 - 선교비전교회">
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-cream to-sand text-charcoal antialiased">
    <PageHeader currentPath="/newcomer" />

    <main class="flex-1 w-full max-w-page mx-auto px-4 lg:px-8 pt-6 lg:pt-8 pb-24 lg:pb-12">
      <section class="mt-6 lg:mt-8 rounded-2xl overflow-hidden bg-gradient-to-br from-forest to-forest-light p-10 lg:p-14 shadow-elevated">
        <div class="flex flex-col sm:flex-row items-center gap-8 text-center sm:text-left">
          <div class="flex-shrink-0 w-20 h-20 rounded-2xl bg-cream/20 flex items-center justify-center">
            <span class="material-symbols-outlined text-cream text-5xl" style="font-variation-settings: 'FILL' 1;">waving_hand</span>
          </div>
          <div>
            <h1 class="font-display text-3xl lg:text-4xl font-semibold text-cream mb-2">환영합니다!</h1>
            <p class="text-cream/90 text-lg leading-relaxed">
              {newcomer?.welcomeMessage || church?.name + '에 오신 것을 진심으로 환영합니다.'}
            </p>
          </div>
        </div>
      </section>

      {newcomer?.welcomeMessage && (
        <section class="pt-8 pb-6">
          <div class="rounded-2xl bg-white p-8 border border-border shadow-soft text-center">
            <p class="text-lg text-charcoal leading-relaxed">{newcomer.welcomeMessage}</p>
          </div>
        </section>
      )}

      {newcomer?.registrationSteps && newcomer.registrationSteps.length > 0 && (
        <section class="pb-6 scroll-reveal">
          <h2 class="font-display text-xl font-semibold text-charcoal mb-6 px-1">시작하기</h2>
          <div class="space-y-4">
            {newcomer.registrationSteps.map((step) => (
              <div class="rounded-2xl bg-sand/50 p-6 border border-border/50 shadow-soft flex items-start gap-6">
                <div class="flex-shrink-0 flex h-12 w-12 items-center justify-center rounded-xl bg-forest text-cream font-bold">
                  {step.step}
                </div>
                <div class="flex-1">
                  <h3 class="font-display text-xl font-semibold text-charcoal mb-2">{step.title}</h3>
                  <p class="text-sm text-ink leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {newcomer?.contactChannels && newcomer.contactChannels.length > 0 && (
        <section class="pb-6">
          <h2 class="font-display text-xl font-semibold text-charcoal mb-6 px-1">연락하기</h2>
          <div class="space-y-4">
            {newcomer.contactChannels
              .filter(channel => channel.available)
              .map((channel) => (
                <a
                  href={
                    channel.type === 'phone' ? `tel:${channel.value}` :
                    channel.type === 'email' ? `mailto:${channel.value}` :
                    channel.value
                  }
                  target={channel.type !== 'phone' && channel.type !== 'email' ? '_blank' : undefined}
                  rel={channel.type !== 'phone' && channel.type !== 'email' ? 'noopener noreferrer' : undefined}
                  class="group rounded-2xl bg-white p-6 border border-border shadow-soft hover:border-forest/30 transition-all block"
                >
                  <div class="flex items-center gap-4">
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-forest/10 text-forest">
                      {channel.type === 'phone' && <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">phone</span>}
                      {channel.type === 'email' && <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">mail</span>}
                      {channel.type === 'kakao' && <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">chat</span>}
                      {channel.type === 'other' && <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">link</span>}
                    </div>
                    <div class="flex-1">
                      <h3 class="font-display text-lg font-semibold text-charcoal mb-1">{channel.label}</h3>
                      <p class="text-sm text-muted">{channel.value}</p>
                    </div>
                    <span class="material-symbols-outlined text-2xl text-muted group-hover:text-forest transition-colors" style="font-variation-settings: 'FILL' 1;">chevron_right</span>
                  </div>
                </a>
              ))}
          </div>
        </section>
      )}

      {newcomer?.meetingInfo && newcomer.meetingInfo.hasMeeting && (
        <section class="pb-8">
          <div class="rounded-2xl bg-white p-8 border border-border shadow-soft">
            <div class="flex items-center gap-4 mb-6">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-forest text-cream">
                <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">groups</span>
              </div>
              <h2 class="font-display text-2xl font-semibold text-charcoal">새가족 모임</h2>
            </div>
            <div class="space-y-4">
              {newcomer.meetingInfo.schedule && (
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-forest">schedule</span>
                  <span class="text-sm font-medium text-charcoal">{newcomer.meetingInfo.schedule}</span>
                </div>
              )}
              {newcomer.meetingInfo.location && (
                <div class="flex items-center gap-3">
                  <span class="material-symbols-outlined text-forest">location_on</span>
                  <span class="text-sm font-medium text-charcoal">{newcomer.meetingInfo.location}</span>
                </div>
              )}
              {newcomer.meetingInfo.description && (
                <p class="text-sm text-ink mt-3 leading-relaxed">{newcomer.meetingInfo.description}</p>
              )}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer church={church} contact={contact} location={location} worship={worship} />
    <BottomNav currentPath="/newcomer" />
    <MenuDrawer />
  </div>
</Layout>
